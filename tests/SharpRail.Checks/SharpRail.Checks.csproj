<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SharpRail.UI/SharpRail.UI.csproj" />
    <ProjectReference Include="../../src/SharpRail.Host.Remote/SharpRail.Host.Remote.csproj" />
    <PackageReference Include="Avalonia.Headless" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <Target Name="BuildTerminalEvents" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="clang -dynamiclib -fobjc-arc -Wall -Wextra -Werror -mmacosx-version-min=13.0 &quot;$(MSBuildProjectDirectory)/TerminalEvents.m&quot; -framework AppKit -framework ApplicationServices -framework IOSurface -framework QuartzCore -o &quot;$(IntermediateOutputPath)libTerminalEvents.dylib&quot;" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)libTerminalEvents.dylib" Link="libTerminalEvents.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
