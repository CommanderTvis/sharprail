<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SharpRail.UI/SharpRail.UI.csproj" />
    <ProjectReference Include="../../src/SharpRail.Host.Remote/SharpRail.Host.Remote.csproj" />
    <ProjectReference Include="../SharpRail.PluginFixture/SharpRail.PluginFixture.Host.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../SharpRail.PluginFixture.UI/SharpRail.PluginFixture.UI.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Avalonia.Headless" />
    <!-- The Android client builds only with the Android workload; its platform-free endpoint is checked here. -->
    <Compile Include="../../src/SharpRail.Android/HostEndpoint.cs" Link="Android/HostEndpoint.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="SharpRail.Plugins.UI.Kit" />
    <Using Include="SharpRail.Plugins.UI.Kit.Editor" />
    <Using Include="SharpRail.Plugins.UI.Kit.Markdown" />
    <Using Include="SharpRail.Plugins.UI.Kit.Visualization" />
  </ItemGroup>
  <Target Name="BuildTerminalEvents" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="clang -dynamiclib -fobjc-arc -Wall -Wextra -Werror -mmacosx-version-min=13.0 &quot;$(MSBuildProjectDirectory)/TerminalEvents.m&quot; -framework AppKit -framework ApplicationServices -framework Carbon -framework IOSurface -framework QuartzCore -o &quot;$(IntermediateOutputPath)libTerminalEvents.dylib&quot;" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)libTerminalEvents.dylib" Link="libTerminalEvents.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
