<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tereditor.UI/Tereditor.UI.csproj" />
    <ProjectReference Include="../../src/Tereditor.Host.Remote/Tereditor.Host.Remote.csproj" />
    <!-- Launched as a child process by the headless check; its output lands next to the checks. -->
    <ProjectReference Include="../../src/Tereditor.Host.Headless/Tereditor.Host.Headless.csproj" />
    <ProjectReference Include="../Tereditor.PluginFixture/Tereditor.PluginFixture.Host.csproj" />
    <ProjectReference Include="../Tereditor.PluginFixture.UI/Tereditor.PluginFixture.UI.csproj" />
    <ProjectReference Include="../../src/Tereditor.Plugins.Acp/Host/Tereditor.Plugins.Acp.Host.csproj" />
    <ProjectReference Include="../../src/Tereditor.Plugins.Isolation/Tereditor.Plugins.Isolation.csproj" />
    <ProjectReference Include="../../src/Tereditor.Plugins.Isolation.UI/Tereditor.Plugins.Isolation.UI.csproj" />
    <!-- The isolation generator as a library, so the crossing checks can run its rules on in-memory snippets. -->
    <ProjectReference Include="../../src/Tereditor.Plugins.Isolation.Generator/Tereditor.Plugins.Isolation.Generator.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- The plugin runner, framework-dependent, in plugin-runner/ of the build output only; a RID publish leaves it out. -->
    <ProjectReference Include="../../src/Tereditor.Plugins.Runner/Tereditor.Plugins.Runner.csproj" ReferenceOutputAssembly="false" OutputItemType="PluginRunnerOutput" Condition="'$(RuntimeIdentifier)' == ''" />
    <!-- The outsider fixture, an external plugin the checks install from disk: plugin-fixture/outsider-ui/ of the build output only. -->
    <ProjectReference Include="../Tereditor.PluginFixture.Outsider/Tereditor.PluginFixture.Outsider.UI.csproj" ReferenceOutputAssembly="false" OutputItemType="OutsiderFixtureOutput" Condition="'$(RuntimeIdentifier)' == ''" />
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia.Headless" />
    <!-- The Android client builds only with the Android workload; its platform-free endpoint is checked here. -->
    <Compile Include="../../src/Tereditor.Android/AndroidJson.cs" Link="Android/AndroidJson.cs" />
    <Compile Include="../../src/Tereditor.Android/EmbeddedTailscaleNetwork.cs" Link="Android/EmbeddedTailscaleNetwork.cs" />
    <Compile Include="../../src/Tereditor.Android/HostEndpoint.cs" Link="Android/HostEndpoint.cs" />
    <Compile Include="../../src/Tereditor.Android/TouchClicks.cs" Link="Android/TouchClicks.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Tereditor.Plugins.UI.Kit" />
    <Using Include="Tereditor.Plugins.UI.Kit.Editor" />
    <Using Include="Tereditor.Plugins.UI.Kit.Markdown" />
    <Using Include="Tereditor.Plugins.UI.Kit.Visualization" />
  </ItemGroup>
  <Target Name="CopyPluginRunner" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <PluginRunnerDirectory>@(PluginRunnerOutput->'%(RootDir)%(Directory)')</PluginRunnerDirectory>
    </PropertyGroup>
    <ItemGroup>
      <PluginRunnerFile Include="$(PluginRunnerDirectory)**" />
    </ItemGroup>
    <Error Condition="'$(PluginRunnerDirectory)' == ''" Text="The plugin runner reference produced no output." />
    <Copy SourceFiles="@(PluginRunnerFile)" DestinationFiles="@(PluginRunnerFile->'$(OutDir)plugin-runner/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyOutsiderFixture" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <OutsiderFixtureDirectory>@(OutsiderFixtureOutput->'%(RootDir)%(Directory)')</OutsiderFixtureDirectory>
    </PropertyGroup>
    <ItemGroup>
      <OutsiderFixtureFile Include="$(OutsiderFixtureDirectory)**" Exclude="$(OutsiderFixtureDirectory)**/*.pdb;$(OutsiderFixtureDirectory)**/*.deps.json" />
    </ItemGroup>
    <Error Condition="'$(OutsiderFixtureDirectory)' == ''" Text="The outsider fixture reference produced no output." />
    <RemoveDir Directories="$(OutDir)plugin-fixture/outsider-ui" />
    <Copy SourceFiles="@(OutsiderFixtureFile)" DestinationFiles="@(OutsiderFixtureFile->'$(OutDir)plugin-fixture/outsider-ui/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="BuildTerminalEvents" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="clang -dynamiclib -fobjc-arc -Wall -Wextra -Werror -mmacosx-version-min=13.0 &quot;$(MSBuildProjectDirectory)/TerminalEvents.m&quot; &quot;$(MSBuildProjectDirectory)/TextureHandoff.m&quot; -framework AppKit -framework ApplicationServices -framework Carbon -framework IOSurface -framework QuartzCore -framework Metal -o &quot;$(IntermediateOutputPath)libTerminalEvents.dylib&quot;" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)libTerminalEvents.dylib" Link="libTerminalEvents.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
