<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org is the only feed, and every package must come from it: nothing resolves from a user-level or
     machine-level source, and a package cannot be served by an unexpected feed. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
