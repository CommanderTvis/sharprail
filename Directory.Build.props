<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <!-- The desktop app, the remote host and headless SharpRail turn NativeAOT on (NativeAot.props); everything else publishes JIT. -->
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!--
      Where this checkout's copies of the Ghostty.Avalonia native libraries go (the Android project reads them too). The
      pinned sources, Zig caches and content-keyed builds they are copied from live in the machine-wide cache
      ($SHARPRAIL_CACHE_DIR/ghostty-avalonia, see src/Ghostty.Avalonia/build-native.sh).
    -->
    <GhosttyNativeCache>$(MSBuildThisFileDirectory)src/Ghostty.Avalonia/obj/native</GhosttyNativeCache>
    <!--
      The Linux desktop runtime the native libraries are built for, from the publish's RuntimeIdentifier on any host (Zig
      cross-compiles them), or from a Linux x64 or arm64 host building without one. Empty everywhere else, which keeps the macOS and
      Windows native targets as they were; linux-x64 and linux-arm64 are built.
    -->
    <SharpRailLinuxRid Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64'">$(RuntimeIdentifier)</SharpRailLinuxRid>
    <SharpRailLinuxRid Condition="'$(SharpRailLinuxRid)' == '' and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'X64'">linux-x64</SharpRailLinuxRid>
    <SharpRailLinuxRid Condition="'$(SharpRailLinuxRid)' == '' and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'Arm64'">linux-arm64</SharpRailLinuxRid>
    <!-- The C compiler of the small Linux helper programs: the pinned Zig against glibc 2.31, as for the NativeAOT link (NativeAot.props). -->
    <SharpRailLinuxCc Condition="'$(SharpRailLinuxRid)' == 'linux-x64'">sh &quot;$(MSBuildThisFileDirectory)scripts/aot-linux-cc.sh&quot; --target=x86_64-linux-gnu</SharpRailLinuxCc>
    <SharpRailLinuxCc Condition="'$(SharpRailLinuxRid)' == 'linux-arm64'">sh &quot;$(MSBuildThisFileDirectory)scripts/aot-linux-cc.sh&quot; --target=aarch64-linux-gnu</SharpRailLinuxCc>
    <!-- Recipes that need the manifest's pins ([env] in mise.toml, tools) run under the checkout's pinned mise. -->
    <MiseRun Condition="'$(OS)' != 'Windows_NT'">sh &quot;$(MSBuildThisFileDirectory)scripts/mise&quot; x --</MiseRun>
    <MiseRun Condition="'$(OS)' == 'Windows_NT'">&quot;$(MSBuildThisFileDirectory)scripts\mise.cmd&quot; x --</MiseRun>
    <!--
      NuGet restore is reproducible and checksum-verified: every project commits a packages.lock.json (direct and
      transitive versions with their content hashes), and mise tasks and CI restore in locked mode (RestoreLockedMode
      in mise.toml [env]), which fails on any drift (NU1004) or changed package content (NU1403). Change locks with
      `scripts/mise run restore:update`. The lock holds one target per RuntimeIdentifiers entry, so the RIDs the
      packages publish with are listed here and a `publish -r <rid>` restore stays inside the lock.
      EXCLUDED from locking (RestorePackagesWithLockFile=false in their project file, each with its reason there):
      SharpRail.Android and SharpRail.Browser, whose restores resolve workload packs and per-RID runtime packs.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">osx-arm64;osx-x64;win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <!--
      Audit: advisories are always reported (all packages, moderate and above) but stay warnings, so a new advisory
      cannot break a nightly build that did not change; CI treats them as errors only through the dedicated
      `scripts/mise run audit` task.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!--
      Everything under src/ except the Android and Browser heads, the plugin runner (the one JIT process, which loads
      plugin assemblies) and the isolation generator (a compiler component) is NativeAOT code: the trim, AOT and single-file analyzers run on every build, so any IL2xxx or
      IL3xxx fails it (src/SharpRail.Plugins.Api/Security.SPEC.md, NativeAOT section).
    -->
    <SharpRailAotAnalyzed Condition="'$(SharpRailAotAnalyzed)' == '' and $([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').StartsWith('src/')) and '$(MSBuildProjectName)' != 'SharpRail.Android' and '$(MSBuildProjectName)' != 'SharpRail.Browser' and '$(MSBuildProjectName)' != 'SharpRail.Plugins.Runner' and '$(MSBuildProjectName)' != 'SharpRail.Plugins.Isolation.Generator'">true</SharpRailAotAnalyzed>
    <IsAotCompatible Condition="'$(SharpRailAotAnalyzed)' == 'true'">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation" Value="true" />
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredPGO" Value="true" />
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.QuickJitForLoops" Value="true" />
  </ItemGroup>
</Project>
