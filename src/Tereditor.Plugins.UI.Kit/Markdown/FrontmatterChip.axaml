<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:SharpRail.Plugins.UI.Kit"
             x:Class="SharpRail.Plugins.UI.Kit.Markdown.FrontmatterChip"
             VerticalAlignment="Center">
  <Border Background="{x:Static kit:Ui.Elevated}" CornerRadius="4" Padding="4,2,2,2" Margin="0,2,4,2">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
      <TextBlock x:Name="Label" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <Button x:Name="Remove" Grid.Column="1" Padding="2" MinHeight="0" MinWidth="0"
              Background="Transparent" BorderThickness="0" />
    </Grid>
  </Border>
</UserControl>
