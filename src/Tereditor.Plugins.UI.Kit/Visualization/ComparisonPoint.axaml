<DockPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:kit="using:Tereditor.Plugins.UI.Kit" x:Class="Tereditor.Plugins.UI.Kit.Visualization.ComparisonPoint"
           x:ClassModifier="internal">
  <ContentControl x:Name="Glyph" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,4,0" />
  <SelectableTextBlock x:Name="Label" Foreground="{x:Static kit:Ui.TextBrush}" FontSize="12" TextWrapping="Wrap" />
</DockPanel>
