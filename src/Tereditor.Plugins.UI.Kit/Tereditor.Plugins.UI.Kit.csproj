<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault><AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tereditor.Scintilla/Tereditor.Scintilla.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="TextMateSharp" />
    <PackageReference Include="TextMateSharp.Grammars" />
    <InternalsVisibleTo Include="Tereditor.Checks" />
    <InternalsVisibleTo Include="Tereditor.UI" />
    <EmbeddedResource Include="Editor/Grammars/*.json" />
    <InternalsVisibleTo Include="Tereditor.Plugins.SpecDialect.UI" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <PropertyGroup>
    <FileIconsDirectory>$(MSBuildProjectDirectory)/obj/file-icons</FileIconsDirectory>
  </PropertyGroup>
  <Target Name="BuildFileIcons" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)/../../scripts/generate-file-icons.cs;$(MSBuildProjectDirectory)/FileIcons/FileIconTable.g.cs"
          Outputs="$(FileIconsDirectory)/file.svg">
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; run &quot;$(MSBuildProjectDirectory)/../../scripts/generate-file-icons.cs&quot; -- --assets-only" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>
  <Target Name="EmbedFileIcons" AfterTargets="BuildFileIcons" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildFileIcons">
    <ItemGroup>
      <FileIconsSvg Include="$(FileIconsDirectory)/*.svg" />
      <EmbeddedResource Include="@(FileIconsSvg)" LogicalName="Tereditor.Plugins.UI.Kit.FileIcons.%(FileIconsSvg.Filename)%(FileIconsSvg.Extension)" />
      <MaterialIconsSvg Include="$(FileIconsDirectory)/material/*.svg" />
      <EmbeddedResource Include="@(MaterialIconsSvg)" LogicalName="Tereditor.Plugins.UI.Kit.FileIcons.material.%(MaterialIconsSvg.Filename)%(MaterialIconsSvg.Extension)" />
    </ItemGroup>
  </Target>
</Project>
