<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SharpRail.PluginRunner</AssemblyName>
    <RootNamespace>SharpRail.Plugins.Runner</RootNamespace>
    <!-- Avalonia's [Unstable] platform interfaces and [PrivateApi] locator, for the remote backend: Security.SPEC.md, UI halves. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <NoWarn>$(NoWarn);AVA3001</NoWarn>
    <SharpRailIsolation>runner</SharpRailIsolation>
  </PropertyGroup>
  <Import Project="../SharpRail.Plugins.Isolation.Generator/Isolation.Generator.props" />
  <ItemGroup>
    <ProjectReference Include="../SharpRail.Plugins.Isolation/SharpRail.Plugins.Isolation.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Isolation.UI/SharpRail.Plugins.Isolation.UI.csproj" />
    <!-- Shared with every plugin it loads, so a plugin's types and the runner's are one: Security.SPEC.md, the runner's shared set. -->
    <ProjectReference Include="../SharpRail.Plugins.UI.Kit/SharpRail.Plugins.UI.Kit.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Chat/SharpRail.Plugins.Chat.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Chat.UI/SharpRail.Plugins.Chat.UI.csproj" />
    <PackageReference Include="Avalonia" />
  </ItemGroup>
</Project>
