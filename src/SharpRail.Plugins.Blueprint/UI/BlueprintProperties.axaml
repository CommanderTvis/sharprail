<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpRail.Plugins.Blueprint.UI.BlueprintProperties">
  <Expander Header="Properties" IsExpanded="True" HorizontalAlignment="Stretch">
    <StackPanel x:Name="Rows" Spacing="4" HorizontalAlignment="Stretch" />
  </Expander>
</UserControl>
