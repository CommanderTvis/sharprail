<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpRail.Plugins.Blueprint.UI.BlueprintProjectAction">
  <Button x:Name="ProjectDraftBlueprint" Width="220" Height="150" Padding="16"
          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid RowDefinitions="*,Auto">
      <ContentControl x:Name="Icon" HorizontalAlignment="Left" VerticalAlignment="Top" />
      <Border x:Name="Badge" CornerRadius="12" Padding="8,2" BorderThickness="1"
              HorizontalAlignment="Right" VerticalAlignment="Top">
        <TextBlock x:Name="BadgeText" Text="new" FontSize="12" />
      </Border>
      <StackPanel Grid.Row="1" Spacing="2">
        <TextBlock x:Name="Title" Text="Draft a blueprint" FontSize="16" />
        <TextBlock x:Name="Description" FontSize="12" TextWrapping="Wrap"
                   Text="Describe an idea; get a spec whose decisions you can change." />
      </StackPanel>
    </Grid>
  </Button>
</UserControl>
