<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpRail.Plugins.Blueprint.UI.BlueprintPropertyRow">
  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto"
        ColumnSpacing="8" RowSpacing="4" Margin="0,0,0,8">
    <ContentControl x:Name="PropertyKey" VerticalAlignment="Center" />
    <ContentControl x:Name="PropertyType" Grid.Column="1" />
    <ContentControl x:Name="PropertyRemove" Grid.Column="2" />
    <ContentControl x:Name="PropertyValue" Grid.Row="1" Grid.ColumnSpan="3"
                    HorizontalContentAlignment="Stretch" />
  </Grid>
</UserControl>
