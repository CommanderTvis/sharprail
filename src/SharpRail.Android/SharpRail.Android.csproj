<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Android client: the workbench of SharpRail.UI compiled for Android, composed as a client of a remote host.
    It compiles the UI's sources rather than referencing its project, whose host-serving half needs ASP.NET Core.
  -->
  <PropertyGroup>
    <!-- Not locked: the android restore resolves workload packs and per-RID Android runtime packs from the installed workload manifest, outside nuget.org's lockable graph. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>SharpRail.UI</AssemblyName>
    <RootNamespace>SharpRail.UI</RootNamespace>
    <ApplicationId>dev.thinkrail.sharprail</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Remote calls use the managed WebSocket/HTTP stack on every platform. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <!-- Native marshal stubs are not generated for this assembly's Java peers; they register at run time instead. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <!-- The solution builds untrimmed (Directory.Build.props), and Android compiles ahead of time only what it trims. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <UiSources>../SharpRail.UI/</UiSources>
    <!-- The shared sources keep their desktop-only paths (the terminal relay child), which Android never reaches. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <!--
    The libraries are built once for the desktop RIDs they are locked for, not per Android RID. They set RuntimeIdentifiers, so the SDK
    does not treat them as RID-agnostic and would pass this project's RuntimeIdentifier (and the inner builds' SkipCompilerExecution) down to
    them: each then compiled nothing into obj/.../android-<arch>/ and failed copying it (MSB3030), or needed android entries in every lock.
  -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <GlobalPropertiesToRemove>RuntimeIdentifier;SelfContained;AppendRuntimeIdentifierToOutputPath;SkipCompilerExecution;_OuterIntermediateAssembly;_OuterOutputPath;_OuterIntermediateOutputPath</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="../SharpRail.Plugins.Tailscale/UI/SharpRail.Plugins.Tailscale.UI.csproj" />
    <!-- Android's implicit usings collide with Avalonia's control names throughout the shared sources. -->
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
    <Using Remove="Android.OS.Bundle" />
    <Compile Include="$(UiSources)**/*.cs" Exclude="$(UiSources)bin/**;$(UiSources)obj/**;$(UiSources)TailscaleDesktopWindow.axaml.cs;$(UiSources)Program.cs;$(UiSources)Terminal/LoopbackTerminals.cs;$(UiSources)Panels/HostSettings.cs" LinkBase="UI" />
    <AvaloniaXaml Include="$(UiSources)**/*.axaml" Exclude="$(UiSources)bin/**;$(UiSources)obj/**;$(UiSources)TailscaleDesktopWindow.axaml" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="$(UiSources)Assets/**" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SharpRail.Host.Core/SharpRail.Host.Core.csproj" />
    <ProjectReference Include="../SharpRail.Host.Client/SharpRail.Host.Client.csproj" />
    <ProjectReference Include="../SharpRail.Scintilla/SharpRail.Scintilla.csproj" />
    <ProjectReference Include="../Ghostty.Avalonia/Ghostty.Avalonia.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Api.UI/SharpRail.Plugins.Api.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.UI.Kit/SharpRail.Plugins.UI.Kit.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.SpecDialect/UI/SharpRail.Plugins.SpecDialect.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Blueprint/UI/SharpRail.Plugins.Blueprint.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.EnvChips/UI/SharpRail.Plugins.EnvChips.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Epub/UI/SharpRail.Plugins.Epub.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.ClaudeCode/UI/SharpRail.Plugins.ClaudeCode.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Discord/UI/SharpRail.Plugins.Discord.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.BranchGraph/UI/SharpRail.Plugins.BranchGraph.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Visualize/UI/SharpRail.Plugins.Visualize.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Codex/UI/SharpRail.Plugins.Codex.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Omp/UI/SharpRail.Plugins.Omp.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.AirGovernance/UI/SharpRail.Plugins.AirGovernance.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.AirContext/UI/SharpRail.Plugins.AirContext.UI.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="Krafs.Publicizer" PrivateAssets="all" />
    <!-- Core PDF preview uses the Android build of PDFium. -->
    <PackageReference Include="bblanchon.PDFium.Android" />
    <PackageReference Include="bblanchon.PDFium.Linux" ExcludeAssets="all" />
    <PackageReference Include="bblanchon.PDFium.macOS" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Avalonia's Android backend has no windows; Windowing/ supplies them over its view and top level, which are internal. -->
    <Publicize Include="Avalonia.Android:Avalonia.Android.Platform.SkiaPlatform.TopLevelImpl" />
    <Publicize Include="Avalonia.Android:Avalonia.Android.Platform.SkiaPlatform.TopLevelImpl.InternalView" />
    <Publicize Include="Avalonia.Android:Avalonia.Android.Platform.SkiaPlatform.TopLevelImpl._systemNavigationManager" />
    <Publicize Include="Avalonia.Android:Avalonia.Android.InvalidationAwareSurfaceView" />
    <Publicize Include="Avalonia.Android:Avalonia.Android.AvaloniaView.TopLevelImpl" />
    <Publicize Include="Avalonia.Android:Avalonia.Android.AvaloniaView._root" />
    <Publicize Include="Avalonia.Android:Avalonia.Android.AvaloniaView.Dispose" />
  </ItemGroup>
  <!-- The terminal state and Tailscale libraries, built with the checkout's NDK for each packaged ABI, and Merman's prebuilt one. -->
  <ItemGroup>
    <NativeAbi Include="arm64-v8a;x86_64" />
    <AndroidNativeSource Include="../Ghostty.Avalonia/Native/GhosttyVt.c;../Ghostty.Avalonia/build-android.sh;../../scripts/build-tailscale-android.sh;Tailscale.Native/*.go;Tailscale.Native/go.mod;Tailscale.Native/go.sum;../../mise.lock;../../mise.android.lock" />
    <!-- Outside a target, %(NativeAbi.Identity) is not batched: it stays literal text and the ABI cannot be read from the path (XA4301). -->
    <AndroidNativeLibrary Include="@(NativeAbi->'$(MSBuildProjectDirectory)/obj/tailscale/%(Identity)/libSharpRailTailscale.so')" />
    <AndroidNativeLibrary Include="@(NativeAbi->'$(GhosttyNativeCache)/android/%(Identity)/libGhosttyAvaloniaVt.so')" />
    <!-- Merman's .so (pinned in mise.android.lock) under the name MermaidRenderer's P/Invoke resolves; it has no SONAME. -->
    <AndroidNativeLibrary Include="@(NativeAbi->'$(MSBuildProjectDirectory)/obj/native/android/%(Identity)/libSharpRailMermaid.so')" />
    <AndroidAsset Include="$(MSBuildProjectDirectory)/obj/tailscale/arm64-v8a/THIRD-PARTY-NOTICES.txt" LogicalName="licenses/tailscale/THIRD-PARTY-NOTICES.txt" />
    <AndroidAsset Include="$(MSBuildProjectDirectory)/obj/tailscale/arm64-v8a/TAILSCALE-LICENSE" LogicalName="licenses/tailscale/TAILSCALE-LICENSE" />
    <AndroidAsset Include="$(MSBuildProjectDirectory)/obj/tailscale/arm64-v8a/GO-LICENSE" LogicalName="licenses/tailscale/GO-LICENSE" />
  </ItemGroup>
  <Target Name="BuildNativeLibraries" BeforeTargets="BeforeBuild"
          Inputs="@(AndroidNativeSource)" Outputs="@(AndroidNativeLibrary)">
    <Exec Command="$(MiseRun) sh &quot;$(MSBuildProjectDirectory)/../../scripts/build-tailscale-android.sh&quot; %(NativeAbi.Identity)" />
    <Exec Command="$(MiseRun) sh &quot;$(MSBuildProjectDirectory)/../Ghostty.Avalonia/build-android.sh&quot; %(NativeAbi.Identity) &quot;$(GhosttyNativeCache)&quot;" />
    <Exec Command="sh &quot;$(MSBuildProjectDirectory)/../../scripts/tool&quot; merman-android" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="MermanAndroidDirectory" />
    </Exec>
    <Copy SourceFiles="$(MermanAndroidDirectory)/jni/%(NativeAbi.Identity)/libmerman_ffi.so"
          DestinationFiles="$(MSBuildProjectDirectory)/obj/native/android/%(NativeAbi.Identity)/libSharpRailMermaid.so" />
  </Target>
  <!-- Avalonia's reference assemblies make its platform interfaces unimplementable; the implementation assemblies do not. -->
  <Target Name="UseAvaloniaImplementationAssemblies" AfterTargets="ResolveAssemblyReferences" BeforeTargets="PublicizeAssemblies">
    <ItemGroup>
      <AvaloniaReferenceAssembly Include="@(ReferencePath->WithMetadataValue('NuGetPackageId', 'Avalonia'))" />
      <ReferencePath Remove="@(AvaloniaReferenceAssembly)" />
      <ReferencePath Include="@(AvaloniaReferenceAssembly->Replace('/ref/', '/lib/')->Replace('\ref\', '\lib\'))" />
    </ItemGroup>
  </Target>
</Project>