<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Tereditor.PluginRunner</AssemblyName>
    <RootNamespace>Tereditor.Plugins.Runner</RootNamespace>
    <!-- Avalonia's [Unstable] platform interfaces and [PrivateApi] locator, for the remote backend: Security.SPEC.md, UI halves. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <NoWarn>$(NoWarn);AVA3001</NoWarn>
    <TereditorIsolation>runner</TereditorIsolation>
  </PropertyGroup>
  <Import Project="../Tereditor.Plugins.Isolation.Generator/Isolation.Generator.props" />
  <ItemGroup>
    <ProjectReference Include="../Tereditor.Plugins.Isolation/Tereditor.Plugins.Isolation.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Isolation.UI/Tereditor.Plugins.Isolation.UI.csproj" />
    <!-- Shared with every plugin it loads, so a plugin's types and the runner's are one: Security.SPEC.md, the runner's shared set. -->
    <ProjectReference Include="../Tereditor.Plugins.UI.Kit/Tereditor.Plugins.UI.Kit.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Chat/Tereditor.Plugins.Chat.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Chat.UI/Tereditor.Plugins.Chat.UI.csproj" />
    <PackageReference Include="Avalonia" />
    <!-- The remote platform backend renders plugin views with Skia's CPU raster and shapes text with HarfBuzz (Security.SPEC.md, UI halves). -->
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
</Project>
