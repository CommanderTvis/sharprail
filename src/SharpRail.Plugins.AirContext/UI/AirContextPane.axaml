<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:SharpRail.Plugins.UI.Kit"
             x:Class="SharpRail.Plugins.AirContext.UI.AirContextPane" x:ClassModifier="internal">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="AirContextSection" Margin="16" Spacing="8">
      <TextBlock x:Name="Workspace" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ContentControl x:Name="ContextBrand" VerticalAlignment="Center" />
        <TextBlock Text="Air Context" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="Semantic code discovery for this workspace. Cloud indexing requires explicit enablement." FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
      <WrapPanel Orientation="Horizontal">
        <Button x:Name="ContextSetup" Content="Review terms and download…" HorizontalAlignment="Left" Click="ContextSetupClicked" Margin="0,0,8,8" />
        <Button x:Name="ContextLogs" Content="Logs…" Click="ContextLogsClicked" Margin="0,0,0,8" />
      </WrapPanel>
      <CheckBox x:Name="ContextEnabled" Content="Enable for this workspace" Click="ContextEnableClicked" />
      <TextBlock x:Name="ContextState" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
      <WrapPanel x:Name="ContextControls" Orientation="Horizontal" IsVisible="False">
        <Button x:Name="ContextLogin" Content="Sign in…" Click="ContextLoginClicked" Margin="0,0,8,8" />
        <Button x:Name="ContextIndex" Content="Index now" Click="ContextIndexClicked" Margin="0,0,8,8" />
        <Button x:Name="ContextStop" Content="Stop" Click="ContextStopClicked" Margin="0,0,8,8" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
