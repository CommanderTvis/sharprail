<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:SharpRail.Plugins.UI.Kit"
             x:Class="SharpRail.Plugins.AirContext.UI.AirContextPane" x:ClassModifier="internal">
  <StackPanel x:Name="AirContextSection" Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <ContentControl x:Name="ContextBrand" VerticalAlignment="Center" />
      <TextBlock Text="Air Context" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="ContextBlurb" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
    <StackPanel x:Name="AccountPart" Spacing="8">
      <WrapPanel Orientation="Horizontal">
        <Button x:Name="ContextSetup" Content="Review terms and download…" HorizontalAlignment="Left" Click="ContextSetupClicked" Margin="0,0,8,8" />
        <Button x:Name="ContextRefresh" Content="Refresh" Click="ContextRefreshClicked" Margin="0,0,0,8" />
      </WrapPanel>
      <TextBlock x:Name="AccountState" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
      <WrapPanel Orientation="Horizontal">
        <Button x:Name="ContextLogin" Content="Sign in…" Click="ContextLoginClicked" Margin="0,0,8,8" />
        <Button x:Name="ContextLogout" Content="Sign out" Click="ContextLogoutClicked" Margin="0,0,8,8" IsVisible="False" />
      </WrapPanel>
    </StackPanel>
    <StackPanel x:Name="WorkspacePart" Spacing="8">
      <CheckBox x:Name="ContextEnabled" Content="Enable for this workspace" Click="ContextEnableClicked" />
      <TextBlock x:Name="ContextState" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
      <StackPanel x:Name="SignInNotice" Orientation="Horizontal" Spacing="8" IsVisible="False">
        <TextBlock Text="Sign in from Settings › Code Intelligence." FontSize="12" Foreground="{x:Static kit:Ui.Warning}" VerticalAlignment="Center" />
        <Button x:Name="ContextOpenSettings" Content="Open Settings" Click="ContextOpenSettingsClicked" />
      </StackPanel>
      <WrapPanel x:Name="ContextControls" Orientation="Horizontal" IsVisible="False">
        <Button x:Name="ContextIndex" Content="Index now" Click="ContextIndexClicked" Margin="0,0,8,8" />
        <Button x:Name="ContextStop" Content="Stop" Click="ContextStopClicked" Margin="0,0,8,8" />
      </WrapPanel>
      <Button x:Name="ContextLogs" Content="Logs…" HorizontalAlignment="Left" Click="ContextLogsClicked" />
    </StackPanel>
  </StackPanel>
</UserControl>
