<Border xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="using:SharpRail.Plugins.UI.Kit"
        x:Class="SharpRail.Plugins.Agent.UI.InstructionSectionsView"
        Name="InstructionSections">
  <Border.Styles>
    <Style Selector="Button.entry, ToggleButton.disclosure">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.entry">
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="ToggleButton.disclosure">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.entry:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.entry:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Static kit:Ui.Hover}" />
    </Style>
    <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="CheckBox.section">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,0,0,0" />
    </Style>
  </Border.Styles>
  <StackPanel>
    <Button x:Name="InstructionSectionsToggle" Classes="entry">
      <DockPanel>
        <ContentControl x:Name="InstructionSectionsSize" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" />
        <ContentControl x:Name="InstructionSectionsIcon" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="2">
          <TextBlock Text="SharpRail's instructions" FontSize="13" Foreground="{x:Static kit:Ui.TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <ContentControl x:Name="InstructionSectionsScope" VerticalAlignment="Center" />
          <TextBlock x:Name="InstructionSectionsCount" FontSize="11" Foreground="{x:Static kit:Ui.Muted}" VerticalAlignment="Center" />
        </WrapPanel>
      </DockPanel>
    </Button>
    <ContentControl x:Name="InstructionSectionsSource" Margin="30,0,8,4" HorizontalAlignment="Left" />
    <StackPanel x:Name="InstructionSectionsBody" Margin="12" Spacing="2" Width="420">
      <TextBlock Text="SharpRail's instructions" FontSize="14" FontWeight="SemiBold" Foreground="{x:Static kit:Ui.TextBrush}" />
      <TextBlock x:Name="InstructionSectionsIntro" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
      <TextBlock FontSize="11" Foreground="{x:Static kit:Ui.Hint}" TextWrapping="Wrap"
                 Text="Changes apply to new sessions; running sessions keep their instructions until restarted." />
      <SelectableTextBlock x:Name="InstructionSectionsPath" FontSize="11" Foreground="{x:Static kit:Ui.Hint}" TextWrapping="Wrap" FontFamily="{x:Static kit:Ui.CodeFont}" />
      <TextBlock x:Name="InstructionSectionsIgnoredEdits" FontSize="12" Foreground="{x:Static kit:Ui.Warning}" TextWrapping="Wrap" IsVisible="False" />
      <TextBlock x:Name="InstructionSectionsDiagnostics" FontSize="12" Foreground="{x:Static kit:Ui.Warning}" TextWrapping="Wrap" IsVisible="False" />
      <StackPanel x:Name="InstructionSectionsGroups" Spacing="2" />
      <TextBlock x:Name="InstructionSectionsUnknown" FontSize="11" Foreground="{x:Static kit:Ui.Hint}" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>
  </StackPanel>
</Border>