<Panel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:kit="using:SharpRail.Plugins.UI.Kit"
       x:Class="SharpRail.Plugins.Codex.UI.CodexSettingValue" x:ClassModifier="internal">
  <Panel.Styles>
    <Style Selector="TextBlock.value">
      <Setter Property="FontFamily" Value="{x:Static kit:Ui.CodeFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{x:Static kit:Ui.Accent}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Panel.Styles>
  <Button x:Name="CodexSettingChange" Padding="0" Background="Transparent" BorderThickness="0"
          HorizontalContentAlignment="Left" ToolTip.Tip="Edit">
    <TextBlock x:Name="ChangeText" Classes="value" />
  </Button>
  <TextBlock x:Name="StaticValue" Classes="value" />
</Panel>
