<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:kit="using:SharpRail.Plugins.UI.Kit"
            x:Class="SharpRail.Plugins.Codex.UI.CodexCapabilitiesFrame" x:ClassModifier="internal">
  <Border Name="CodexCapability" Tag="hooks" Padding="8,4" BorderBrush="{x:Static kit:Ui.BorderBrush}" BorderThickness="0,0,0,1">
    <DockPanel>
      <ContentControl x:Name="HooksAction" DockPanel.Dock="Right" />
      <StackPanel Spacing="2">
        <TextBlock Text="SharpRail status hooks" FontFamily="{x:Static kit:Ui.CodeFont}" FontSize="12" Foreground="{x:Static kit:Ui.TextBrush}" />
        <TextBlock x:Name="HooksDetail" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" TextTrimming="None" />
      </StackPanel>
    </DockPanel>
  </Border>
  <StackPanel x:Name="Servers" />
  <Border Padding="8,4" BorderBrush="{x:Static kit:Ui.BorderBrush}" BorderThickness="0,0,0,1">
    <StackPanel Spacing="2">
      <TextBlock Text="thinkrail" FontFamily="{x:Static kit:Ui.CodeFont}" FontSize="12" Foreground="{x:Static kit:Ui.TextBrush}" />
      <TextBlock Text="SharpRail's own MCP server, added to every session the launcher starts unless turned off in Settings."
                 FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" TextTrimming="None" />
    </StackPanel>
  </Border>
</StackPanel>
