<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Ghostty.Avalonia</RootNamespace>
    <!-- Where build-native.sh keeps Ghostty sources, Zig toolchains and the built libraries. -->
    <GhosttyNativeCache Condition="'$(GhosttyNativeCache)' == ''">$(MSBuildProjectDirectory)/obj/native</GhosttyNativeCache>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="HarfBuzzSharp" />
    <InternalsVisibleTo Include="SharpRail.Checks" />
    <Content Include="licenses/RoyalTerminal-MIT.txt" Link="licenses/RoyalTerminal-MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Update="Avalonia" Version="12.1.3" />
    <PackageReference Update="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Update="SkiaSharp" Version="4.148.0" />
    <PackageReference Update="HarfBuzzSharp" Version="14.2.1.301" />
  </ItemGroup>
  <ItemGroup>
    <GhosttyNativeSource Include="$(MSBuildProjectDirectory)/Native/*" Exclude="$(MSBuildProjectDirectory)/Native/terminal-check.m;$(MSBuildProjectDirectory)/Native/Wasm.patch" />
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <GhosttyWindowsRid Condition="$(RuntimeIdentifier.StartsWith('win-'))">$(RuntimeIdentifier)</GhosttyWindowsRid>
    <GhosttyWindowsRid Condition="'$(GhosttyWindowsRid)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'Arm64'">win-arm64</GhosttyWindowsRid>
    <GhosttyWindowsRid Condition="'$(GhosttyWindowsRid)' == ''">win-x64</GhosttyWindowsRid>
  </PropertyGroup>
  <ItemGroup Condition="'$(GhosttyWindowsRid)' != ''">
    <Content Include="$(GhosttyNativeCache)/$(GhosttyWindowsRid)/GhosttyAvaloniaVt.dll" Link="GhosttyAvaloniaVt.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(SharpRailLinuxRid)' != ''">
    <Content Include="$(GhosttyNativeCache)/$(SharpRailLinuxRid)/libGhosttyAvaloniaVt.so" Link="libGhosttyAvaloniaVt.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Native libraries are MSBuild targets: they rebuild when a source, the recipe or the lockfile is newer than the output. -->
  <Target Name="BuildGhosttyWindows" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" Condition="'$(GhosttyWindowsRid)' != ''"
          Inputs="@(GhosttyNativeSource);$(MSBuildProjectDirectory)/build-windows.ps1;$(MSBuildThisFileDirectory)../../scripts/windows-native.ps1;$(MSBuildThisFileDirectory)../../mise.lock"
          Outputs="$(GhosttyNativeCache)/$(GhosttyWindowsRid)/GhosttyAvaloniaVt.dll">
    <Exec Command="$(MiseRun) powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/build-windows.ps1&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot; -Cache &quot;$(GhosttyNativeCache)&quot;" />
  </Target>
  <Target Name="BuildGhosttyLinux" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" Condition="'$(SharpRailLinuxRid)' != ''"
          Inputs="@(GhosttyNativeSource);$(MSBuildProjectDirectory)/build-linux.sh;$(MSBuildThisFileDirectory)../../mise.toml;$(MSBuildThisFileDirectory)../../mise.lock"
          Outputs="$(GhosttyNativeCache)/$(SharpRailLinuxRid)/libGhosttyAvaloniaVt.so">
    <Exec Command="$(MiseRun) sh &quot;$(MSBuildProjectDirectory)/build-linux.sh&quot; &quot;$(SharpRailLinuxRid)&quot; &quot;$(GhosttyNativeCache)&quot;" />
  </Target>
  <Target Name="BuildGhosttyNative" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(SharpRailLinuxRid)' == ''"
          Inputs="@(GhosttyNativeSource);$(MSBuildProjectDirectory)/build-native.sh;$(MSBuildThisFileDirectory)../../mise.toml;$(MSBuildThisFileDirectory)../../mise.lock"
          Outputs="$(GhosttyNativeCache)/libGhosttyAvaloniaView.dylib;$(GhosttyNativeCache)/libGhosttyAvaloniaVt.dylib">
    <Exec Command="$(MiseRun) sh &quot;$(MSBuildProjectDirectory)/build-native.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(GhosttyNativeCache)&quot;" />
  </Target>
  <!-- Declared apart from the build so that an up-to-date build still packages the libraries. -->
  <Target Name="IncludeGhosttyNative" DependsOnTargets="BuildGhosttyNative" BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(SharpRailLinuxRid)' == ''">
    <ItemGroup>
      <GhosttyResources Include="$(GhosttyNativeCache)/resources/**/*" />
      <Content Include="$(GhosttyNativeCache)/libGhosttyAvaloniaView.dylib" Link="libGhosttyAvaloniaView.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="$(GhosttyNativeCache)/libGhosttyAvaloniaVt.dylib" Link="libGhosttyAvaloniaVt.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="@(GhosttyResources)" Link="%(GhosttyResources.RecursiveDir)%(GhosttyResources.Filename)%(GhosttyResources.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
