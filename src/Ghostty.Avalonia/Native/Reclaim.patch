+
+        /// Replaces the targets of every frame but the most recently drawn one
+        /// (the frame the apprt may still present) with 1x1 ones, freeing their
+        /// GPU memory. The draws that follow resize each target to the
+        /// unchanged surface size when they reach it, so the grid, the terminal
+        /// state and the PTY are untouched. Idempotent.
+        ///
+        /// Must be called on the render thread.
+        pub fn gavReclaimTargets(self: *Self) void {
+            self.draw_mutex.lockUncancelable(global.io());
+            defer self.draw_mutex.unlock(global.io());
+            // A released swap chain holds no targets.
+            const sc = &(self.swap_chain orelse return);
+
+            // No frame may be in flight on the GPU.
+            for (0..SwapChain.buf_count) |_| sc.frame_sema.waitUncancelable(global.io());
+            defer for (0..SwapChain.buf_count) |_| sc.frame_sema.post(global.io());
+
+            for (&sc.frames, 0..) |*frame, index| {
+                if (index == sc.frame_index) continue;
+                if (frame.target.width == 1 and frame.target.height == 1) continue;
+                const target = self.api.initTarget(1, 1) catch continue;
+                frame.target.deinit();
+                frame.target = target;
+            }
         }
 
