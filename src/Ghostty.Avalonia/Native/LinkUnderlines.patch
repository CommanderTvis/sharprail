+        pub const gav_hidden = std.math.maxInt(u32);
+
+        /// Reads the logical line through viewport row `row` (from its first wrapped row, possibly in scrollback, to
+        /// its last) into gav_line_codes, one entry per cell: the base codepoint, a space for a blank cell and 0 for
+        /// the right half of a wide character; and into gav_line_cells each cell's viewport index, or gav_hidden
+        /// outside the viewport. Returns the first viewport row after the line. Caller must hold the state mutex.
+        pub fn gavReadLine(self: *Self, pages: *terminal.PageList, row: u32) !u32 {
+            self.gav_line_codes.clearRetainingCapacity();
+            self.gav_line_cells.clearRetainingCapacity();
+            var pin = pages.pin(.{ .viewport = .{ .y = @intCast(row) } }) orelse return row + 1;
+            var y: i64 = row;
+            var up: usize = 0;
+            while (up < 64) : (up += 1) {
+                const above = pin.up(1) orelse break;
+                if (!above.rowAndCell().row.wrap) break;
+                pin = above;
+                y -= 1;
+            }
+            var down: usize = 0;
+            while (true) : (down += 1) {
+                const visible = y >= 0 and y < pages.rows;
+                for (pin.cells(.all), 0..) |cell, x| {
+                    const codepoint: u32 = if (cell.wide == .spacer_tail) 0 else if (cell.codepoint() == 0) ' ' else cell.codepoint();
+                    try self.gav_line_codes.append(self.alloc, codepoint);
+                    try self.gav_line_cells.append(self.alloc, if (visible) @intCast(y * pages.cols + @as(i64, @intCast(x))) else gav_hidden);
+                }
+                if (!pin.rowAndCell().row.wrap or down >= 128) break;
+                pin = pin.down(1) orelse break;
+                y += 1;
+            }
+            return @intCast(@max(y + 1, @as(i64, row) + 1));
+        }
+
+        /// The key of the line last read by gavReadLine: its cells without trailing blanks.
+        pub fn gavLineKey(self: *Self) []const u8 {
+            var len = self.gav_line_codes.items.len;
+            while (len > 0 and self.gav_line_codes.items[len - 1] == ' ') len -= 1;
+            return std.mem.sliceAsBytes(self.gav_line_codes.items[0..len]);
+        }
+
+        pub fn gavClearLineLinks(self: *Self) void {
+            var it = self.gav_line_links.iterator();
+            while (it.next()) |entry| {
+                self.alloc.free(entry.key_ptr.*);
+                self.alloc.free(entry.value_ptr.*);
+            }
+            self.gav_line_links.clearRetainingCapacity();
+        }
+
+        /// Attaches `marks` (indexes into the line last read by gavReadLine) to that line's text, replacing what it
+        /// had; no marks detaches the line when `replace` is set and keeps it otherwise. Caller must hold the mutex.
+        pub fn gavSetLineLinks(self: *Self, marks: []const u32, replace: bool) !void {
+            const key = self.gavLineKey();
+            if (marks.len == 0) {
+                if (!replace) return;
+                if (self.gav_line_links.fetchRemove(key)) |old| {
+                    self.alloc.free(old.key);
+                    self.alloc.free(old.value);
+                }
+                return;
+            }
+            if (self.gav_line_links.count() >= 4096) self.gavClearLineLinks();
+            const value = try self.alloc.dupe(u32, marks);
+            errdefer self.alloc.free(value);
+            const entry = try self.gav_line_links.getOrPut(self.alloc, key);
+            if (entry.found_existing) {
+                self.alloc.free(entry.value_ptr.*);
+            } else {
+                entry.key_ptr.* = self.alloc.dupe(u8, key) catch |err| {
+                    _ = self.gav_line_links.remove(key);
+                    return err;
+                };
+            }
+            entry.value_ptr.* = value;
+        }
