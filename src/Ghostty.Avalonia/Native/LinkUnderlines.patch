+        /// Maps the file-link cells to this frame's viewport. A cell is underlined only while it still shows the
+        /// codepoint it was resolved with. Returns whether the underlined cells differ from the previous frame.
+        /// Caller must hold the renderer state mutex.
+        fn gavPlaceLinks(self: *Self, t: *terminal.Terminal) !bool {
+            var next: std.AutoHashMapUnmanaged(u32, void) = .empty;
+            errdefer next.deinit(self.alloc);
+            const pages = &t.screen.pages;
+            if (self.gav_links.items.len > 0) place: {
+                const top_pin = pages.pin(.{ .viewport = .{} }) orelse break :place;
+                const top = (pages.pointFromPin(.screen, top_pin) orelse break :place).screen.y;
+                for (self.gav_links.items) |entry| {
+                    if (entry.screen != t.active_screen or entry.y < top or entry.y - top >= pages.rows or entry.x >= pages.cols) continue;
+                    const y: terminal.size.CellCountInt = @intCast(entry.y - top);
+                    const cell = pages.getCell(.{ .viewport = .{ .x = entry.x, .y = y } }) orelse continue;
+                    const codepoint: u21 = if (cell.cell.codepoint() == 0) ' ' else cell.cell.codepoint();
+                    if (codepoint != entry.codepoint) continue;
+                    const index = @as(u32, y) * pages.cols + entry.x;
+                    try next.put(self.alloc, index, {});
+                    if (cell.cell.wide == .wide and entry.x + 1 < pages.cols) try next.put(self.alloc, index + 1, {});
+                }
+            }
+            var changed = next.count() != self.gav_visible.count();
+            if (!changed) {
+                var it = next.keyIterator();
+                while (it.next()) |key| if (!self.gav_visible.contains(key.*)) {
+                    changed = true;
+                    break;
+                };
+            }
+            self.gav_visible.deinit(self.alloc);
+            self.gav_visible = next;
+            return changed;
         }
 
