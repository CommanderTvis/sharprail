+    /// SharpRail: a command that exited non-zero marks its command line (the input row above its output).
+    pub fn endOfCommand(self: *StreamHandler, exit_code: ?u8) !void {
+        const code = exit_code orelse return;
+        if (code == 0) return;
+        var pin = self.terminal.screen.cursor.page_pin.*;
+        var steps: usize = 0;
+        while (steps < 10_000) : (steps += 1) {
+            pin = pin.up(1) orelse return;
+            const row = pin.rowAndCell().row;
+            switch (row.semantic_prompt) {
+                .input, .prompt => {
+                    row.command_failed = true;
+                    return;
+                },
+                else => {},
+            }
+        }
+    }
+
