+    /// tereditor: a command that exited non-zero marks its command line (the prompt row above its output).
+    fn markFailedCommand(self: *StreamHandler, code: u8) void {
+        if (code == 0) return;
+        var pin = self.terminal.screens.active.cursor.page_pin.*;
+        var steps: usize = 0;
+        while (steps < 10_000) : (steps += 1) {
+            pin = pin.up(1) orelse return;
+            const row = pin.rowAndCell().row;
+            switch (row.semantic_prompt) {
+                .prompt, .prompt_continuation => {
+                    row.command_failed = true;
+                    return;
+                },
+                .none => {},
+            }
+        }
+    }
