+// A logical range of a bidirectional line may occupy several visual intervals.
+std::vector<Interval> VisualSpans(IScreenLineLayout *slLayout, const LineLayout *ll, ForwardRange lineRange,
+	int start, int end, int xStart, XYPOSITION horizontalOffset) {
+	if (!slLayout)
+		return { ll->Span(start, end).Offset(horizontalOffset) };
+	std::vector<Interval> intervals = slLayout->FindRangeIntervals(start - lineRange.First(), end - lineRange.First());
+	for (Interval &interval : intervals)
+		interval = interval.Offset(xStart);
+	return intervals;
+}
