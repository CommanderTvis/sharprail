<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:SharpRail.Plugins.UI.Kit"
             x:Class="SharpRail.UI.Editor.CodeDocumentView">
  <Grid RowDefinitions="Auto,*">
    <Border x:Name="FileDeletedOnDisk" IsVisible="False" BorderThickness="0,0,0,1" Padding="8,4">
      <TextBlock Text="This file was deleted on disk. What you see is the last version the tab read." FontSize="12" />
    </Border>
    <Grid Grid.Row="1">
      <ContentControl x:Name="CodeBody" />
      <ContentControl x:Name="CodeFindBody" ZIndex="1" />
    </Grid>
    <Popup x:Name="LanguagePopup" IsLightDismissEnabled="True" Placement="BottomEdgeAlignedLeft">
      <Border x:Name="LanguageResults" Background="{x:Static kit:Ui.Elevated}" BorderBrush="{x:Static kit:Ui.ControlBorder}" BorderThickness="1" CornerRadius="6" Width="620" MaxHeight="360">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,8">
            <TextBlock x:Name="LanguageHeading" Text="LSP results" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ComboBox x:Name="LanguageScope" Grid.Column="1" SelectedIndex="1" MinWidth="118" FontSize="12" Margin="8,0" ToolTip.Tip="Search the current file, workspace, or loaded graph including dependencies. Module scope requires reliable provider ownership." IsVisible="False">
              <ComboBoxItem Content="File" />
              <ComboBoxItem Content="Workspace" />
              <ComboBoxItem Content="With dependencies" />
            </ComboBox>
            <Button x:Name="LanguageHide" Grid.Column="2" Content="Close" />
          </Grid>
          <TextBlock x:Name="LanguageStatus" Grid.Row="1" TextWrapping="Wrap" Foreground="{x:Static kit:Ui.Muted}" FontSize="12" Margin="12,0,12,8" />
          <TextBox x:Name="LanguageQuery" Grid.Row="2" PlaceholderText="Filter results" Margin="8,0,8,8" AutomationProperties.Name="Filter language results" />
          <ListBox x:Name="LanguageItems" Grid.Row="3" MaxHeight="240" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{x:Static kit:Ui.Hover}" />
                <Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:CompileBindings="False">
                <StackPanel Spacing="4" Margin="4,0">
                  <Border IsVisible="{Binding StartsFile}" BorderBrush="{x:Static kit:Ui.ControlBorder}" BorderThickness="0,0,0,1" Padding="0,4,0,4" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Directory}" Margin="8,0" Foreground="{x:Static kit:Ui.Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding FileCount}" Foreground="{x:Static kit:Ui.Muted}" FontSize="12" />
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="44,*">
                    <TextBlock Text="{Binding LineNumber}" FontFamily="{x:Static kit:Ui.CodeFont}" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Name="LanguagePreview" FontFamily="{x:Static kit:Ui.CodeFont}" FontSize="12" Loaded="PreviewLoaded" DataContextChanged="PreviewDataChanged" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="LanguageEmpty" Grid.Row="3" Text="No results" IsVisible="False" Foreground="{x:Static kit:Ui.Muted}" Margin="16" />
          <Border x:Name="LanguageSelectionFooter" Grid.Row="4" BorderBrush="{x:Static kit:Ui.ControlBorder}" BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock x:Name="LanguageSelection" Foreground="{x:Static kit:Ui.Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </Border>
          <TextBlock x:Name="LanguageKeys" Grid.Row="5" Text="↑ ↓ select    Enter navigate    Esc close" Foreground="{x:Static kit:Ui.Muted}" FontSize="12" Margin="12,0,12,8" />
        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>