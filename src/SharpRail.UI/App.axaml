<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:SharpRail.Plugins.UI.Kit"
             x:Class="SharpRail.UI.App"
             Name="SharpRail">
  <Application.Resources>
    <x:Double x:Key="TreeViewItemIndent">12</x:Double>
    <ControlTheme x:Key="{x:Type rendering:Switch}" TargetType="rendering:Switch">
      <Setter Property="Foreground" Value="{x:Static rendering:Ui.TextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
            <Border x:Name="PART_Track" Width="32" Height="18" CornerRadius="9" BorderThickness="1" VerticalAlignment="Center"
                    Background="{x:Static rendering:Ui.ControlFill}" BorderBrush="{x:Static rendering:Ui.ControlBorderActive}">
              <Border x:Name="PART_Thumb" Width="12" Height="12" CornerRadius="6" Margin="2,0"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Static rendering:Ui.Muted}" />
            </Border>
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Border#PART_Track">
        <Setter Property="Background" Value="{x:Static rendering:Ui.PrimaryFill}" />
        <Setter Property="BorderBrush" Value="{x:Static rendering:Ui.PrimaryFill}" />
      </Style>
      <Style Selector="^:checked /template/ Border#PART_Thumb">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Background" Value="{x:Static rendering:Ui.OnPrimary}" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Track">
        <Setter Property="BorderBrush" Value="{x:Static rendering:Ui.Accent}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{x:Static rendering:Ui.ControlDisabledText}" />
      </Style>
      <Style Selector="^:disabled /template/ Border#PART_Track">
        <Setter Property="Background" Value="{x:Static rendering:Ui.ControlDisabledFill}" />
        <Setter Property="BorderBrush" Value="{x:Static rendering:Ui.ControlDisabledBorder}" />
      </Style>
      <Style Selector="^:disabled /template/ Border#PART_Thumb">
        <Setter Property="Background" Value="{x:Static rendering:Ui.ControlDisabledText}" />
      </Style>
    </ControlTheme>
  </Application.Resources>
  <Application.Styles>
    <Style Selector="Border.change-row">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.change-row.active">
      <Setter Property="Background" Value="{x:Static rendering:Ui.Selected}" />
    </Style>
    <Style Selector="Border.change-row:pointerover, Border.change-row.menu-open">
      <Setter Property="Background" Value="{x:Static rendering:Ui.Hover}" />
    </Style>
    <Style Selector="Border.project-row">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.project-row.active">
      <Setter Property="Background" Value="{x:Static rendering:Ui.Selected}" />
    </Style>
    <Style Selector="Border.project-row:pointerover">
      <Setter Property="Background" Value="{x:Static rendering:Ui.Hover}" />
    </Style>
    <Style Selector="Button.project-name:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.project-name:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.change-actions">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.change-row:pointerover Button.change-actions, Border.change-row.menu-open Button.change-actions, Button.change-actions:focus">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="{x:Static rendering:Ui.TextSelection}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource ThemeSelectionForeground}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="SelectionBrush" Value="{x:Static rendering:Ui.TextSelection}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource ThemeSelectionForeground}" />
    </Style>
    <Style Selector="FlyoutPresenter.tab-search">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" />
        <ColorPaletteResources x:Key="Light" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- The tab frame paints hover and selection; pressing a tab (to drag it) must not tint or shrink it. -->
    <Style Selector="Button.dock-tab-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.dock-tab-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.dock-tab-button:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <!-- A long menu (a branch's commits) scrolls inside a bounded height and trims its rows instead of growing sideways. -->
    <Style Selector="ContextMenu">
      <Setter Property="MaxHeight" Value="480" />
      <Setter Property="MaxWidth" Value="420" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="Button#BranchDelete:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Menus, flyouts and tooltips scale with the page zoom of the window that opened them. -->
    <Style Selector="Popup">
      <Setter Property="InheritsTransform" Value="True" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="28" />
    </Style>
  </Application.Styles>
</Application>
