<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:SharpRail.UI.Rendering"
             x:Class="SharpRail.UI.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <x:Double x:Key="TreeViewItemIndent">12</x:Double>
  </Application.Resources>
  <Application.Styles>
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="{x:Static rendering:Ui.TextSelection}" />
      <Setter Property="SelectionForegroundBrush" Value="{x:Null}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="SelectionBrush" Value="{x:Static rendering:Ui.TextSelection}" />
      <Setter Property="SelectionForegroundBrush" Value="{x:Null}" />
    </Style>
    <Style Selector="FlyoutPresenter.tab-search">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#8dff4f" />
        <ColorPaletteResources x:Key="Light" Accent="#2a7314" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="Margin" Value="4,0" />
    </Style>
  </Application.Styles>
</Application>
