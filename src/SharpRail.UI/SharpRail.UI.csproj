<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SharpRail.Host.Core/SharpRail.Host.Core.csproj" />
    <ProjectReference Include="../SharpRail.Host.Client/SharpRail.Host.Client.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <Target Name="BuildMermaid" BeforeTargets="PrepareForBuild">
    <Exec Command="sh &quot;$(MSBuildProjectDirectory)/../../scripts/build-merman.sh&quot;" />
    <ItemGroup>
      <MermaidLibrary Include="../../.tools/merman/*SharpRailMermaid.*" />
      <Content Include="@(MermaidLibrary)" Link="%(MermaidLibrary.Filename)%(MermaidLibrary.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="BuildGhostty" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="sh &quot;$(MSBuildProjectDirectory)/../../scripts/build-ghostty.sh&quot; &quot;$(RuntimeIdentifier)&quot;" />
    <ItemGroup>
      <GhosttyResources Include="../../.tools/ghostty/resources/**/*" />
    </ItemGroup>
    <ItemGroup>
      <Content Include="../../.tools/ghostty/libSharpRailGhostty.dylib" Link="libSharpRailGhostty.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="@(GhosttyResources)" Link="%(GhosttyResources.RecursiveDir)%(GhosttyResources.Filename)%(GhosttyResources.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ScintillaArch Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64'">x86_64</ScintillaArch>
    <ScintillaArch Condition="'$(ScintillaArch)' == '' or '$(RuntimeIdentifier)' == 'osx-arm64'">arm64</ScintillaArch>
    <ScintillaArch Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64</ScintillaArch>
  </PropertyGroup>
  <ItemGroup Condition="'$(ScintillaArch)' != ''">
    <Content Include="../../.tools/scintilla-build/$(ScintillaArch)/libSharpRail.Scintilla.dylib" Link="libSharpRail.Scintilla.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildScintilla" BeforeTargets="PrepareForBuild" Condition="'$(ScintillaArch)' != ''">
    <Exec Command="&quot;$(MSBuildProjectDirectory)/../../scripts/build-scintilla.sh&quot; $(ScintillaArch)" />
  </Target>
</Project>
