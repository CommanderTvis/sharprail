<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SharpRail.Host.Core/SharpRail.Host.Core.csproj" />
    <ProjectReference Include="../SharpRail.Host.Client/SharpRail.Host.Client.csproj" />
    <ProjectReference Include="../SharpRail.Scintilla/SharpRail.Scintilla.csproj" />
    <ProjectReference Include="../Ghostty.Avalonia/Ghostty.Avalonia.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <AvaloniaResource Include="Assets/**" />
    <InternalsVisibleTo Include="SharpRail.Checks" />
  </ItemGroup>
  <Target Name="BuildMermaid" BeforeTargets="PrepareForBuild">
    <Exec Command="sh &quot;$(MSBuildProjectDirectory)/../../scripts/build-merman.sh&quot;" />
    <ItemGroup>
      <MermaidLibrary Include="../../.tools/merman/*SharpRailMermaid.*" />
      <Content Include="@(MermaidLibrary)" Link="%(MermaidLibrary.Filename)%(MermaidLibrary.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
