<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../DesktopGc.props" />
  <PropertyGroup><OutputType>WinExe</OutputType><AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <!-- The About screen's version: the packaging tasks pass SharpRailBuildStamp (UTC date and short commit); a local build reads "dev". -->
  <PropertyGroup>
    <InformationalVersion Condition="'$(SharpRailBuildStamp)' == ''">dev</InformationalVersion>
    <InformationalVersion Condition="'$(SharpRailBuildStamp)' != ''">0.2.0+$(SharpRailBuildStamp)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SharpRail.Plugins.Tailscale/UI/SharpRail.Plugins.Tailscale.UI.csproj" />
    <ProjectReference Include="../SharpRail.Host.Core/SharpRail.Host.Core.csproj" />
    <ProjectReference Include="../SharpRail.Host.Client/SharpRail.Host.Client.csproj" />
    <ProjectReference Include="../SharpRail.Host.Remote/SharpRail.Host.Remote.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../SharpRail.Scintilla/SharpRail.Scintilla.csproj" />
    <ProjectReference Include="../Ghostty.Avalonia/Ghostty.Avalonia.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Api.UI/SharpRail.Plugins.Api.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.UI.Kit/SharpRail.Plugins.UI.Kit.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.SpecDialect/UI/SharpRail.Plugins.SpecDialect.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Blueprint/UI/SharpRail.Plugins.Blueprint.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.ClaudeCode/UI/SharpRail.Plugins.ClaudeCode.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Discord/UI/SharpRail.Plugins.Discord.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.BranchGraph/UI/SharpRail.Plugins.BranchGraph.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Visualize/UI/SharpRail.Plugins.Visualize.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.Codex/UI/SharpRail.Plugins.Codex.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.AirGovernance/UI/SharpRail.Plugins.AirGovernance.UI.csproj" />
    <ProjectReference Include="../SharpRail.Plugins.AirContext/UI/SharpRail.Plugins.AirContext.UI.csproj" />
    <PackageReference Include="bblanchon.PDFium.macOS" />
    <PackageReference Include="bblanchon.PDFium.Linux" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <AvaloniaResource Include="Assets/**" />
    <InternalsVisibleTo Include="SharpRail.Checks" />
  </ItemGroup>
  <PropertyGroup>
    <MermaidLibrary>$(MSBuildProjectDirectory)/obj/native/libSharpRailMermaid.dylib</MermaidLibrary>
    <NotificationsLibrary>$(MSBuildProjectDirectory)/obj/native/libSharpRailNotifications.dylib</NotificationsLibrary>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(SharpRailLinuxRid)' == ''">
    <Content Include="$(MermaidLibrary)" Link="libSharpRailMermaid.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NotificationsLibrary)" Link="libSharpRailNotifications.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Native libraries are MSBuild targets: they rebuild when an input is newer than the output, and only then. -->
  <Target Name="BuildMermaid" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(SharpRailLinuxRid)' == ''"
          Inputs="$(MSBuildProjectDirectory)/../../scripts/build-merman.sh;$(MSBuildProjectDirectory)/../../mise.lock" Outputs="$(MermaidLibrary)">
    <Exec Command="$(MiseRun) sh &quot;$(MSBuildProjectDirectory)/../../scripts/build-merman.sh&quot; &quot;$(MermaidLibrary)&quot;" />
  </Target>
  <Target Name="BuildNotifications" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(SharpRailLinuxRid)' == ''"
          Inputs="$(MSBuildProjectDirectory)/Native/Notifications.m;$(MSBuildProjectDirectory)/../../scripts/build-notifications.sh" Outputs="$(NotificationsLibrary)">
    <Exec Command="sh &quot;$(MSBuildProjectDirectory)/../../scripts/build-notifications.sh&quot; &quot;$(NotificationsLibrary)&quot;" />
  </Target>
</Project>
