<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:SharpRail.UI.Rendering"
             x:Class="SharpRail.UI.Rendering.MarkdownDocumentView">
  <Grid RowDefinitions="32,*">
    <Border Background="{x:Static rendering:Ui.Header}"
            BorderBrush="{x:Static rendering:Ui.BorderBrush}" BorderThickness="0,0,0,1"
            Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button x:Name="MarkdownOutlineToggle" Content="Outline" FontSize="12"
                MinHeight="0" Padding="8,2" BorderThickness="0" CornerRadius="4"
                VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="MarkdownPreviewMode" Content="Preview" FontSize="12"
                  MinHeight="0" Padding="8,2" BorderThickness="0" CornerRadius="4" />
          <Button x:Name="MarkdownSourceMode" Content="Source" FontSize="12"
                  MinHeight="0" Padding="8,2" BorderThickness="0" CornerRadius="4" />
          <Button x:Name="MarkdownSplitMode" Content="Split" FontSize="12"
                  MinHeight="0" Padding="8,2" BorderThickness="0" CornerRadius="4" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="MarkdownBody" Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*">
      <Border x:Name="MarkdownOutline" IsVisible="False" Width="220"
              BorderBrush="{x:Static rendering:Ui.BorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="MarkdownOutlineEntries" Margin="8" Spacing="2" />
        </ScrollViewer>
      </Border>
      <GridSplitter x:Name="MarkdownSplitter" Grid.Column="2" Width="1"
                    Background="{x:Static rendering:Ui.BorderBrush}" ResizeDirection="Columns" />
    </Grid>
  </Grid>
</UserControl>
