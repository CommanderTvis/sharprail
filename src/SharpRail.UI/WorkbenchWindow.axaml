<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="using:SharpRail.Plugins.UI.Kit"
        xmlns:local="using:SharpRail.UI"
        xmlns:notifications="using:SharpRail.UI.Rendering"
        x:Class="SharpRail.UI.WorkbenchWindow"
        Title="SharpRail" Width="1440" Height="920" MinWidth="390" MinHeight="540"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="48"
        Background="{x:Static rendering:Ui.Workspace}" Foreground="{x:Static rendering:Ui.Muted}"
        FontFamily="{x:Static rendering:Ui.InterfaceFont}" FontWeight="370">
  <Window.Styles>
    <Style Selector="TextBlock.header-label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.location-segment">
      <Setter Property="BorderBrush" Value="{x:Static rendering:Ui.BorderBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="Padding" Value="16,0,12,0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.location-caption">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LineHeight" Value="10" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Foreground" Value="{x:Static rendering:Ui.Hint}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.location-pill">
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </Window.Styles>
  <LayoutTransformControl x:Name="ZoomRoot" LayoutTransform="{DynamicResource InterfaceZoom}">
  <Grid x:Name="WorkbenchRoot" RowDefinitions="48,*,Auto">
    <Border x:Name="WindowTitleBar" Background="{x:Static rendering:Ui.Header}"
            BorderBrush="{x:Static rendering:Ui.BorderBrush}" BorderThickness="0,0,1,1">
      <Grid x:Name="MainHeader" ColumnDefinitions="36,*,Auto">
        <ContentControl x:Name="BrandIcon" />
        <Button x:Name="LeftDrawerButton" IsVisible="False" Width="36" Height="48" Padding="0"
                Background="Transparent" BorderThickness="0" CornerRadius="0"
                ToolTip.Tip="Projects" AutomationProperties.Name="Projects" />
        <local:LocationStrip x:Name="LocationBar" Grid.Column="1" ClipToBounds="True">
          <Border x:Name="ProjectSegment" Classes="location-segment" MaxWidth="220" BorderThickness="0" Padding="8,0,12,0">
            <Grid RowDefinitions="10,4,22" VerticalAlignment="Center">
              <TextBlock Classes="location-caption" Text="PROJECT" />
              <Button x:Name="ScopeProject" Grid.Row="2" Classes="location-pill">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="ProjectLabel" Text="…" Classes="header-label" Foreground="{x:Static rendering:Ui.TextBrush}" />
                  <ContentControl x:Name="ProjectChevron" Grid.Column="1" Margin="4,0,0,0" />
                </Grid>
              </Button>
            </Grid>
          </Border>
          <Border x:Name="WorkspaceSegment" Classes="location-segment" MaxWidth="460">
            <Grid RowDefinitions="10,4,22" VerticalAlignment="Center">
              <TextBlock Classes="location-caption" Text="WORKSPACE" />
              <Button x:Name="ScopeWorkspace" Grid.Row="2" Classes="location-pill">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="WorkspaceLabel" Text="" Classes="header-label" FontWeight="Medium" Foreground="{x:Static rendering:Ui.TextBrush}" />
                  <ContentControl x:Name="WorkspaceChevron" Grid.Column="1" Margin="4,0,0,0" />
                </Grid>
              </Button>
              <ContentControl x:Name="ScopeRename" Grid.Row="2" IsVisible="False" />
            </Grid>
          </Border>
          <Border x:Name="BranchSegment" Classes="location-segment" MaxWidth="440" IsVisible="False">
            <Grid RowDefinitions="10,4,22" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="location-caption" Text="BRANCH" />
                <TextBlock x:Name="ScopeBase" Classes="location-caption" FontFamily="{x:Static rendering:Ui.CodeFont}" />
              </StackPanel>
              <Button x:Name="ScopeBranch" Grid.Row="2" Classes="location-pill">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ContentControl x:Name="BranchIcon" Margin="0,0,4,0" />
                  <TextBlock x:Name="BranchLabel" Grid.Column="1" Classes="header-label" FontFamily="{x:Static rendering:Ui.CodeFont}" />
                  <ContentControl x:Name="BranchChevron" Grid.Column="2" Margin="4,0,0,0" />
                </Grid>
              </Button>
            </Grid>
          </Border>
        </local:LocationStrip>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock x:Name="ConnectionDot" Text="●" Classes="header-label" FontSize="10" Foreground="{x:Static rendering:Ui.Success}" />
          <TextBlock x:Name="ConnectionStatus" Text="Connecting" Classes="header-label" />
          <Button x:Name="RightDrawerButton" IsVisible="False" Width="32" Height="32" Padding="0"
                  Background="Transparent" BorderThickness="0" CornerRadius="0"
                  ToolTip.Tip="Files and changes" AutomationProperties.Name="Files and changes" />
          <Button x:Name="SettingsButton" Width="32" Height="32" Padding="0"
                  Background="Transparent" BorderThickness="0" CornerRadius="0"
                  ToolTip.Tip="Settings (⌘,)" AutomationProperties.Name="Settings (⌘,)" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock x:Name="WorkspaceError" Grid.Row="2" FontSize="12" Margin="12,4"
               Foreground="{x:Static rendering:Ui.Danger}" TextWrapping="Wrap" IsVisible="False"
               Classes="header-label" />
    <Border x:Name="QuitHintOverlay" Grid.Row="1" ZIndex="31" IsVisible="False" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,12,12,24" Padding="16,12"
            Background="{x:Static rendering:Ui.Elevated}" BorderBrush="{x:Static rendering:Ui.BorderBrush}"
            BorderThickness="1" CornerRadius="4" AutomationProperties.LiveSetting="Assertive">
      <TextBlock x:Name="QuitHintMessage" Foreground="{x:Static rendering:Ui.TextBrush}" FontSize="14" TextWrapping="Wrap" />
    </Border>
    <StackPanel Grid.Row="1" ZIndex="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Spacing="8">
    <notifications:ToastStack x:Name="ToastStack" Width="356" />
    <Border x:Name="GestureToast" IsVisible="False" Width="356"
            Background="{x:Static rendering:Ui.Elevated}" BorderBrush="{x:Static rendering:Ui.BorderBrush}"
            BorderThickness="0,1,1,1" CornerRadius="4" ClipToBounds="True">
      <Grid ColumnDefinitions="4,*">
        <Border Background="{x:Static rendering:Ui.Accent}" />
        <Grid Grid.Column="1" ColumnDefinitions="*,24" Margin="12">
          <TextBlock x:Name="GestureToastMessage" Text="The layout changed. Your drag was canceled."
                     Foreground="{x:Static rendering:Ui.Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,8,0" />
          <Button x:Name="DismissGestureToast" Grid.Column="1" Width="24" Height="24" Margin="0,-4,-4,0"
                  VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="0"
                  AutomationProperties.Name="Dismiss" />
        </Grid>
      </Grid>
    </Border>
    </StackPanel>
  </Grid>
  </LayoutTransformControl>
</Window>
