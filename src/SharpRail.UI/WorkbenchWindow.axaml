<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="using:SharpRail.Plugins.UI.Kit"
        x:Class="SharpRail.UI.WorkbenchWindow"
        Title="SharpRail" Width="1440" Height="920" MinWidth="390" MinHeight="540"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="40"
        Background="{x:Static rendering:Ui.Surface}" Foreground="{x:Static rendering:Ui.Muted}"
        FontFamily="{x:Static rendering:Ui.InterfaceFont}" FontWeight="370">
  <Window.Styles>
    <Style Selector="TextBlock.header-label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Styles>
  <LayoutTransformControl x:Name="ZoomRoot" LayoutTransform="{DynamicResource InterfaceZoom}">
  <Grid x:Name="WorkbenchRoot" RowDefinitions="40,*,Auto">
    <Border x:Name="WindowTitleBar" Background="{x:Static rendering:Ui.Header}"
            BorderBrush="{x:Static rendering:Ui.BorderBrush}" BorderThickness="0,0,1,1">
      <Grid x:Name="MainHeader" ColumnDefinitions="36,*,Auto">
        <ContentControl x:Name="BrandIcon" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ClipToBounds="True">
          <TextBlock x:Name="ProjectLabel" Text="…" Classes="header-label" MaxWidth="160" Foreground="{x:Static rendering:Ui.TextBrush}" />
          <TextBlock x:Name="ScopeSeparator" Text="›" Classes="header-label" />
          <TextBlock x:Name="WorkspaceLabel" Text="" Classes="header-label" MaxWidth="220" Foreground="{x:Static rendering:Ui.TextBrush}" />
          <Button x:Name="BranchButton" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center" IsVisible="False"
                  Background="Transparent" BorderThickness="0" CornerRadius="4"
                  ToolTip.Tip="Branches" AutomationProperties.Name="Branches">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ContentControl x:Name="BranchIcon" />
              <TextBlock x:Name="BranchLabel" Classes="header-label" />
              <ContentControl x:Name="BranchChevron" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock x:Name="ConnectionDot" Text="●" Classes="header-label" FontSize="10" Foreground="{x:Static rendering:Ui.Success}" />
          <TextBlock x:Name="ConnectionStatus" Text="Connecting" Classes="header-label" />
          <Button x:Name="SettingsButton" Width="32" Height="32" Padding="7"
                  Background="Transparent" BorderThickness="0" CornerRadius="0"
                  ToolTip.Tip="Settings (⌘,)" AutomationProperties.Name="Settings (⌘,)" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock x:Name="WorkspaceError" Grid.Row="2" FontSize="12" Margin="12,4"
               Foreground="{x:Static rendering:Ui.Danger}" TextWrapping="Wrap" IsVisible="False"
               Classes="header-label" />
    <Border x:Name="GestureToast" Grid.Row="1" ZIndex="30" IsVisible="False"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="356" Margin="12"
            Background="{x:Static rendering:Ui.Elevated}" BorderBrush="{x:Static rendering:Ui.BorderBrush}"
            BorderThickness="0,1,1,1" CornerRadius="4" ClipToBounds="True">
      <Grid ColumnDefinitions="4,*">
        <Border Background="{x:Static rendering:Ui.Accent}" />
        <Grid Grid.Column="1" ColumnDefinitions="*,24" Margin="12">
          <TextBlock x:Name="GestureToastMessage" Text="The layout changed. Your drag was canceled."
                     Foreground="{x:Static rendering:Ui.Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,8,0" />
          <Button x:Name="DismissGestureToast" Grid.Column="1" Width="24" Height="24" Margin="0,-4,-4,0"
                  VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="5"
                  AutomationProperties.Name="Dismiss" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
  </LayoutTransformControl>
</Window>
