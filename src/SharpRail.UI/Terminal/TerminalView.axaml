<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:SharpRail.UI.Rendering"
             x:Class="SharpRail.UI.Terminal.TerminalView"
             FontFamily="{x:Static rendering:Ui.InterfaceFont}" Foreground="{x:Static rendering:Ui.TextBrush}">
  <Grid RowDefinitions="*,Auto">
    <ContentControl x:Name="TerminalBody" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    <StackPanel x:Name="TerminalStartFailure" IsVisible="False" Spacing="10" MaxWidth="520" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="The terminal couldn’t start" FontSize="15" FontWeight="SemiBold" />
      <SelectableTextBlock x:Name="TerminalStartFailureText" TextWrapping="Wrap" />
      <TextBlock TextWrapping="Wrap" Foreground="{x:Static rendering:Ui.Muted}"
                 Text="Check that the workspace folder still exists and that your login shell can start, then retry. The tab stays open." />
      <Button x:Name="TerminalStartRetry" Content="Retry" HorizontalAlignment="Left" />
    </StackPanel>
    <Border x:Name="TerminalDetached" IsVisible="False" Background="{x:Static rendering:Ui.Surface}">
      <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="This terminal is open somewhere else." HorizontalAlignment="Center"
                   Foreground="{x:Static rendering:Ui.Muted}" FontSize="12" />
        <Button x:Name="TerminalTakeBack" Content="Take it back" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
    <TextBlock x:Name="TerminalExited" Grid.Row="1" IsVisible="False" Margin="12,4"
               Foreground="{x:Static rendering:Ui.Muted}" FontSize="12" />
  </Grid>
</UserControl>
