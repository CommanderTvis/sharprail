<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpRail.UI.Terminal.TerminalKeyBar">
  <UniformGrid Columns="6" Rows="2">
    <Button x:Name="EscapeKey" Content="Esc" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
    <Button x:Name="TabKey" Content="Tab" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
    <ToggleButton x:Name="CtrlKey" Content="Ctrl" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
    <ToggleButton x:Name="AltKey" Content="Alt" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
    <Button x:Name="PageUpKey" Content="PgUp" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
    <Button x:Name="PageDownKey" Content="PgDn" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
    <Button x:Name="HomeKey" Content="Home" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
    <Button x:Name="LeftKey" Content="←" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
    <Button x:Name="DownKey" Content="↓" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
    <Button x:Name="UpKey" Content="↑" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
    <Button x:Name="RightKey" Content="→" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
    <Button x:Name="EndKey" Content="End" Focusable="False" MinHeight="40" Padding="4,2" Margin="2" />
  </UniformGrid>
</UserControl>
