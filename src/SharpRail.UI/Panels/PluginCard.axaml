<Border xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="using:SharpRail.Plugins.UI.Kit"
        x:Class="SharpRail.UI.Panels.PluginCard" x:ClassModifier="internal" Name="PluginRow">
  <StackPanel>
    <TextBlock x:Name="PluginCategory" Classes="settings-label" Margin="0,12,0,8" IsVisible="False" />
    <Border x:Name="PluginFrame" Margin="0,0,0,8" Padding="12,8" CornerRadius="4" BorderThickness="1"
            BorderBrush="{x:Static kit:Ui.BorderBrush}" Background="{x:Static kit:Ui.Elevated}">
      <Border.Styles>
        <Style Selector="TextBlock">
          <Setter Property="FontWeight" Value="{x:Static kit:Ui.InterfaceWeight}" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.wrapped">
          <Setter Property="FontSize" Value="12" />
          <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
      </Border.Styles>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <ContentControl x:Name="PluginIcon" VerticalAlignment="Top" Margin="0,2,0,0" />
        <StackPanel Grid.Column="1" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="PluginLabel" Foreground="{x:Static kit:Ui.TextBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PluginVersion" Foreground="{x:Static kit:Ui.Hint}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <Border x:Name="PluginOrigin" BorderBrush="{x:Static kit:Ui.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,0">
              <TextBlock x:Name="PluginOriginText" Foreground="{x:Static kit:Ui.Hint}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </Border>
            <Border x:Name="PluginSupport" Background="{x:Static kit:Ui.WarningWash}" CornerRadius="8" Padding="8,0" IsVisible="False">
              <TextBlock x:Name="PluginSupportText" Foreground="{x:Static kit:Ui.Warning}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </Border>
            <TextBlock x:Name="PluginStatus" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock x:Name="PluginDescription" Classes="wrapped" Foreground="{x:Static kit:Ui.TextBrush}" />
          <TextBlock x:Name="PluginContributions" Classes="wrapped" Foreground="{x:Static kit:Ui.Muted}" />
          <TextBlock x:Name="PluginReason" Classes="wrapped" Foreground="{x:Static kit:Ui.Danger}" />
          <TextBlock x:Name="PluginDependents" Classes="wrapped" Foreground="{x:Static kit:Ui.Muted}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <ContentControl x:Name="PluginRetrySlot" />
          <ToggleSwitch x:Name="PluginToggle" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</Border>
