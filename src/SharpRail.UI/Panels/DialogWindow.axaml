<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="using:SharpRail.UI.Rendering"
        x:Class="SharpRail.UI.Panels.DialogWindow"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{x:Static rendering:Ui.Surface}" Foreground="{x:Static rendering:Ui.TextBrush}"
        FontFamily="{x:Static rendering:Ui.InterfaceFont}" FontSize="14">
  <StackPanel x:Name="DialogBody" Margin="20" Spacing="10">
    <TextBlock x:Name="DialogHeading" FontSize="18" FontWeight="370"
               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="DialogExplanation" IsVisible="False" TextWrapping="Wrap"
               Foreground="{x:Static rendering:Ui.Muted}" />
    <StackPanel x:Name="DialogFields" Spacing="10" />
    <StackPanel x:Name="DialogActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" />
  </StackPanel>
</Window>
