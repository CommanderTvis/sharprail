<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="using:SharpRail.Plugins.UI.Kit"
        xmlns:local="using:SharpRail.UI.Panels"
        x:Class="SharpRail.UI.Panels.SettingsWindow"
        Title="Settings"
        Width="832" Height="680" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner" WindowDecorations="None" CanResize="False"
        Background="Transparent" TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="{x:Static rendering:Ui.Elevated}"
        Foreground="{x:Static rendering:Ui.TextBrush}"
        FontFamily="{x:Static rendering:Ui.InterfaceFont}" FontSize="14" FontWeight="370">
  <Window.Resources>
    <DataTemplate x:Key="HighlightingPage">
      <StackPanel Spacing="8">
        <TextBlock Text="Syntax highlighting" Classes="settings-heading" />
        <TextBlock Text="Custom highlighting applies to file editors, Markdown source and diffs. Grammars and filename patterns are shared by every client of this host." Classes="settings-description" />
        <TextBlock Text="Want some highlighting?" Classes="settings-label" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="HighlightingAskClaude" Content="Ask Claude to add it" />
          <Button x:Name="HighlightingAskCodex" Content="Ask Codex to add it" />
        </StackPanel>
        <TextBlock Text="Opens an agent in your current workspace using the builtin add-highlighting skill." Classes="settings-description" />
        <TextBlock Text="Filename patterns" Classes="settings-label" Margin="0,16,0,0" />
        <TextBox x:Name="HighlightingPatterns" PlaceholderText="*.foo, Foofile" />
        <TextBlock Text="TextMate grammar (JSON)" Classes="settings-label" />
        <TextBox x:Name="HighlightingGrammar" AcceptsReturn="True" Height="160" FontFamily="{x:Static rendering:Ui.CodeFont}" PlaceholderText="Paste a .tmLanguage.json grammar or choose a file" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="HighlightingChoose" Content="Choose grammar file…" />
          <Button x:Name="HighlightingImport" Content="Add highlighting" />
        </StackPanel>
        <TextBlock x:Name="HighlightingError" Foreground="{x:Static rendering:Ui.Danger}" TextWrapping="Wrap" IsVisible="False" />
        <TextBlock Text="Custom grammars" Classes="settings-heading" Margin="0,16,0,0" />
        <StackPanel x:Name="HighlightingGrammars" Spacing="8" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="HighlightingGrammarRow">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock x:Name="HighlightingGrammarLabel" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button x:Name="HighlightingRemove" Grid.Column="1" Content="Remove" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="HostPage">
      <StackPanel Spacing="8">
        <TextBlock Text="Host" Classes="settings-heading" />
        <TextBlock x:Name="HostDescription" Text="Let other SharpRail clients connect to this running app. They share its projects, settings, plugins and terminals." Classes="settings-description" />
        <StackPanel x:Name="HostControls" Spacing="8">
          <TextBlock Text="Bind address" Classes="settings-label" />
          <TextBox x:Name="HostAddress" MaxWidth="360" HorizontalAlignment="Left" />
          <TextBlock Text="127.0.0.1 accepts connections from this computer. Use a network address to accept other computers." Classes="settings-description" />
          <TextBlock Text="Port" Classes="settings-label" />
          <TextBox x:Name="HostPort" Width="120" HorizontalAlignment="Left" />
          <TextBlock Text="Use 0 to choose an available port." Classes="settings-description" />
          <TextBlock Text="Session token" Classes="settings-label" />
          <TextBox x:Name="HostToken" PasswordChar="●" MaxWidth="360" HorizontalAlignment="Left" />
          <TextBlock Text="Clients use this token to connect. Serving stays off until you start it, and stops when the app quits." Classes="settings-description" />
          <TextBlock x:Name="HostStatus" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="HostToggle" Content="Start listening" />
            <Button x:Name="HostCopyEndpoint" Content="Copy endpoint" />
            <Button x:Name="HostCopyToken" Content="Copy token" />
            <Button x:Name="HostShowCode" ToolTip.Tip="Show a QR code to connect a phone" AutomationProperties.Name="Show a QR code to connect a phone" />
          </StackPanel>
          <StackPanel x:Name="HostCode" Spacing="8" IsVisible="False" HorizontalAlignment="Left">
            <local:QrCodeView x:Name="HostCodeImage" Width="240" Height="240" HorizontalAlignment="Left" />
            <TextBlock x:Name="HostCodeDetail" MaxWidth="360" Classes="settings-description" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="AppearancePage">
      <StackPanel Spacing="8">
        <TextBlock Text="Theme" Classes="settings-heading" />
        <TextBlock Text="Your mode and pair are shared by every window and client of this host. Match system follows each device’s light or dark setting." Classes="settings-description" />
        <StackPanel x:Name="ThemeModeChoices" Spacing="4" AutomationProperties.Name="Theme mode" />
        <StackPanel x:Name="ThemeChoices" Spacing="4" />
        <StackPanel x:Name="SystemThemes" Spacing="8">
          <Grid x:Name="SystemThemeCurrent" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="Current on this device" Classes="settings-description" VerticalAlignment="Center" />
            <StackPanel x:Name="SystemThemeCurrentValue" Grid.Column="1" Orientation="Horizontal" Spacing="4" />
          </Grid>
          <TextBlock Text="Light theme" Classes="settings-label" />
          <Button x:Name="SystemTheme_light_trigger" Classes="theme-trigger" />
          <TextBlock x:Name="SystemTheme_light_fallback" Classes="theme-fallback" />
          <TextBlock Text="Dark theme" Classes="settings-label" />
          <Button x:Name="SystemTheme_dark_trigger" Classes="theme-trigger" />
          <TextBlock x:Name="SystemTheme_dark_fallback" Classes="theme-fallback" />
        </StackPanel>
        <TextBlock Text="Interface font size" Classes="settings-label" />
        <NumericUpDown x:Name="InterfaceSize" Minimum="10" Maximum="24" Increment="1" Width="150" HorizontalAlignment="Left" />
        <TextBlock Text="Geist for the interface · JetBrains Mono for code" FontSize="12" Foreground="{x:Static rendering:Ui.Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="LineWidthPage">
      <StackPanel Spacing="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Line width" Classes="settings-heading" />
          <TextBlock Text="Set the visual wrap column for source files and rendered Markdown. These preferences are shared by every window and client of this host." Classes="settings-description" />
        </StackPanel>
        <ContentControl x:Name="FileLineWidthHost" />
        <ContentControl x:Name="MarkdownLineWidthHost" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="LineWidthControl">
      <StackPanel Spacing="12">
        <Border Height="1" Background="{x:Static rendering:Ui.BorderBrush}" />
        <StackPanel Spacing="4">
          <TextBlock x:Name="LineWidthTitle" Classes="settings-heading" />
          <TextBlock x:Name="LineWidthDescription" Classes="settings-description" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <StackPanel Spacing="4">
            <TextBlock Text="Line width" Classes="settings-description" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="LineWidthInput" Width="96" />
              <TextBlock Text="symbols" Classes="settings-description" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <Button x:Name="LineWidthSave" Content="Save" VerticalAlignment="Bottom" />
        </StackPanel>
        <TextBlock x:Name="LineWidthError" Text="Enter a whole number from 40 to 240." FontSize="12"
                   Foreground="{x:Static rendering:Ui.Danger}" IsVisible="False" />
        <rendering:Switch x:Name="LineWidthBounded" Label="Limit lines to this width" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="LayoutPage">
      <StackPanel Spacing="8">
        <TextBlock Text="Layout" Classes="settings-heading" />
        <TextBlock Text="The frame, default preset and group limits belong to this window; custom presets are shared by every window and client of this host. Each workspace retains its own open documents." Classes="settings-description" />
        <StackPanel x:Name="PresetChoices" Spacing="8" />
        <StackPanel x:Name="PresetSaveRow" Orientation="Horizontal" Spacing="8" MaxWidth="512" HorizontalAlignment="Left">
          <TextBox x:Name="PresetName" PlaceholderText="Preset name" Width="260" MaxLength="200" />
          <ContentControl x:Name="SavePreset" />
        </StackPanel>
        <TextBlock Text="Group limits" Classes="settings-label" />
        <TextBlock Text="Applies to new groups. Existing over-limit arrangements remain usable and reducible." Classes="settings-description" />
        <StackPanel x:Name="GroupLimits" MaxWidth="384" HorizontalAlignment="Left" Spacing="8" />
        <TextBlock Text="Bottom alignment" Classes="settings-label" />
        <ComboBox x:Name="BottomAlignment" Width="220" />
        <TextBlock x:Name="EditorTabsLabel" Text="Editor tabs" Classes="settings-label" />
        <TextBlock x:Name="EditorTabsDetail" Text="A column beside the editor instead of a strip above it. Drag its edge to resize. A split centre keeps the strip, since two columns leave too little room for the editors." Classes="settings-description" />
        <CheckBox x:Name="VerticalCenterTabs" Content="Show editor tabs vertically" />
        <CheckBox x:Name="VerticalTabsInProjects">
          <StackPanel Spacing="2">
            <TextBlock Text="Keep them in Projects, under their workspace" />
            <TextBlock Text="One column instead of two: each workspace lists its open tabs and its start buttons in the Projects view, and the editor takes the whole centre. Tabs of another workspace switch to it when clicked." Classes="settings-description" />
          </StackPanel>
        </CheckBox>
        <TextBlock x:Name="PaneDirectionLabel" Text="Tabs shown together open as" />
        <StackPanel x:Name="PaneDirections" Orientation="Horizontal" Spacing="4" />
        <TextBlock x:Name="PaneDirectionDetail" Classes="settings-description" />
        <CheckBox x:Name="PreviewTabs" Content="Preview files before keeping them" />
        <TextBlock Text="A single click opens a file in the group's reusable preview tab and a double click keeps it. Off, every open keeps its own tab. This preference belongs to this app." Classes="settings-description" />
        <ContentControl x:Name="ResetFrame" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TerminalPage">
      <StackPanel Spacing="8">
        <StackPanel x:Name="TerminalRendererSection" Spacing="8" Margin="0,0,0,16">
          <TextBlock Text="Terminal renderer" Classes="settings-heading" />
          <TextBlock Text="A preference of this app. Changing it redraws open terminals; their shells keep running." Classes="settings-description" />
          <StackPanel x:Name="TerminalRendererChoices" Spacing="8" />
        </StackPanel>
        <TextBlock Text="Replayed output" Classes="settings-heading" />
        <TextBlock Text="A terminal keeps running when you leave it, but its view is rebuilt when you come back. This is how much of its recent output the host keeps so the screen is restored too. Shared by every client of this host; applies to terminals opened from now on." Classes="settings-description" TextWrapping="Wrap" />
        <StackPanel x:Name="TerminalReplayChoices" Spacing="8" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="NotificationsPage">
      <StackPanel Spacing="8">
        <TextBlock Text="Notifications" Classes="settings-heading" />
        <TextBlock Text="Get a desktop notification when a terminal needs you: an agent asks a question, finishes, or fails. Notifications only appear while no SharpRail window is focused. Shared by every client of this host." Classes="settings-description" />
        <Border Padding="12,8" CornerRadius="4" BorderThickness="1" BorderBrush="{x:Static rendering:Ui.BorderBrush}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="Enable notifications" Classes="settings-label" />
            <rendering:Switch x:Name="NotificationsEnabled" Grid.Column="1" Label="Enable notifications" />
          </Grid>
        </Border>
        <TextBlock x:Name="NotificationsChannel" Classes="settings-description" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="GitHubPage">
      <StackPanel Spacing="8">
        <TextBlock Text="Local GitHub" Classes="settings-heading" />
        <TextBlock Text="SharpRail uses the GitHub CLI on this computer; it stores no credentials." Classes="settings-description" />
        <StackPanel x:Name="GitHubStatus" Spacing="4">
          <TextBlock x:Name="GitHubStatusText" Text="Checking…" Classes="settings-label" />
          <TextBlock x:Name="GitHubStatusDetail" Classes="settings-description" />
        </StackPanel>
        <ContentControl x:Name="GitHubRefreshHost" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ProjectsPage">
      <StackPanel Spacing="8">
        <TextBlock Text="Projects" Classes="settings-heading" />
        <TextBlock Text="The project list is shared by every window and client of this host." Classes="settings-description" />
        <TextBlock Text="Recent projects" Classes="settings-label" />
        <StackPanel x:Name="RecentProjects" Spacing="8" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock.settings-label, TextBlock.settings-heading">
      <Setter Property="Foreground" Value="{x:Static rendering:Ui.TextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.settings-heading">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.settings-description">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{x:Static rendering:Ui.Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.theme-trigger">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{x:Static rendering:Ui.Elevated}" />
      <Setter Property="BorderBrush" Value="{x:Static rendering:Ui.BorderBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.theme-fallback">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{x:Static rendering:Ui.Warning}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.invalid">
      <Setter Property="BorderBrush" Value="{x:Static rendering:Ui.Danger}" />
    </Style>
    <Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement, TextBox.invalid:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{x:Static rendering:Ui.Danger}" />
    </Style>
    <Style Selector="Button.settings-navigation">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{x:Static rendering:Ui.Elevated}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>
  <LayoutTransformControl LayoutTransform="{DynamicResource InterfaceZoom}">
  <Border x:Name="SettingsFrame" Background="{x:Static rendering:Ui.Elevated}"
          BorderBrush="{x:Static rendering:Ui.BorderBrush}" BorderThickness="1" CornerRadius="8">
    <Grid RowDefinitions="42.5,*">
      <Border BorderBrush="{x:Static rendering:Ui.BorderBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0,12,0">
          <Button x:Name="SettingsBack" IsVisible="False" Width="24" Height="24" Padding="4" Margin="-4,0,8,0"
                  CornerRadius="4" Background="Transparent" BorderThickness="0"
                  ToolTip.Tip="All settings" AutomationProperties.Name="All settings" />
          <TextBlock x:Name="SettingsTitle" Grid.Column="1" Text="Settings" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="SettingsClose" Grid.Column="2" Width="24" Height="24" Padding="4"
                  CornerRadius="4" Background="Transparent" BorderThickness="0"
                  ToolTip.Tip="Close settings (Escape)" AutomationProperties.Name="Close settings (Escape)" />
        </Grid>
      </Border>
      <Grid x:Name="SettingsColumns" Grid.Row="1" ColumnDefinitions="192,*">
        <Border x:Name="SettingsNavigationPane" Background="{x:Static rendering:Ui.Elevated}" BorderBrush="{x:Static rendering:Ui.BorderBrush}"
                BorderThickness="0,0,1,0">
          <ScrollViewer>
            <StackPanel x:Name="SettingsNavigation" Spacing="2" Margin="12">
              <Button x:Name="Settings_Appearance" Classes="settings-navigation" />
              <Button x:Name="Settings_Highlighting" Classes="settings-navigation" />
              <Button x:Name="Settings_Line_width" Classes="settings-navigation" />
              <Button x:Name="Settings_Layout" Classes="settings-navigation" />
              <Button x:Name="Settings_Projects" Classes="settings-navigation" />
              <Button x:Name="Settings_Terminal" Classes="settings-navigation" />
              <Button x:Name="Settings_Notifications" Classes="settings-navigation" />
              <Button x:Name="Settings_Host" Classes="settings-navigation" />
              <Button x:Name="Settings_GitHub" Classes="settings-navigation" />
              <Button x:Name="Settings_Plugins" Classes="settings-navigation" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <ScrollViewer Grid.Column="1" Padding="16">
          <ContentControl x:Name="SettingsBody" />
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
  </LayoutTransformControl>
</Window>
