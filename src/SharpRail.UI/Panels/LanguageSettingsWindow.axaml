<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="using:SharpRail.Plugins.UI.Kit"
        x:Class="SharpRail.UI.Panels.LanguageSettingsWindow"
        Width="640" Height="640" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" WindowDecorations="None" ShowInTaskbar="False"
        Background="{x:Static kit:Ui.Elevated}"
        Foreground="{x:Static kit:Ui.TextBrush}" FontFamily="{x:Static kit:Ui.InterfaceFont}" FontSize="14">
  <Border Padding="24" BorderThickness="1" BorderBrush="{x:Static kit:Ui.BorderBrush}">
    <Grid RowDefinitions="Auto,Auto,*">
      <TextBlock x:Name="SettingsHeading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
      <TextBlock Grid.Row="1" x:Name="SettingsWorkspace" TextWrapping="Wrap" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" Margin="0,0,0,16" />
      <ContentControl Grid.Row="2" x:Name="SettingsBody" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
  </Border>
</Window>
