<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:kit="using:SharpRail.Plugins.UI.Kit" x:Class="SharpRail.UI.Panels.LanguageLimitsView">
  <StackPanel Spacing="8" Margin="0,8">
    <TextBlock Text="Running servers and limits · all workspaces on this host" FontWeight="SemiBold" />
    <TextBlock Text="Servers stop when unused for the idle timeout, when all of them together pass the memory budget (least recently used first) or when the system is short of memory. A server with an open editor or a request in progress is never stopped; a stopped server starts again on its next request." FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
    <TextBlock x:Name="LimitsSummary" TextWrapping="Wrap" />
    <StackPanel x:Name="RunningServers" Spacing="2" AutomationProperties.Name="Running language servers" />
    <Border Classes="settings-row">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="Idle timeout, minutes (0 never)" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Width="96" x:Name="LimitsIdle" AutomationProperties.Name="Idle timeout in minutes" />
      </Grid>
    </Border>
    <Border Classes="settings-row">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="Memory budget, MiB (0 automatic)" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Width="96" x:Name="LimitsBudget" AutomationProperties.Name="Memory budget in MiB" />
      </Grid>
    </Border>
    <Border Classes="settings-row">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="Maximum running C# language servers" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Width="96" x:Name="LimitsCSharp" AutomationProperties.Name="Maximum running C# language servers" />
      </Grid>
    </Border>
    <Border Classes="settings-row">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="Maximum running JVM servers of one kind" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Width="96" x:Name="LimitsJvm" AutomationProperties.Name="Maximum running JVM language servers of one kind" />
      </Grid>
    </Border>
    <Border Classes="settings-row">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="Maximum running servers of any other kind" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Width="96" x:Name="LimitsOther" AutomationProperties.Name="Maximum running language servers of any other kind" />
      </Grid>
    </Border>
    <Button x:Name="LimitsSave" Content="Save limits" HorizontalAlignment="Left" Click="SaveClicked" />
    <TextBlock x:Name="LimitsMessage" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
