<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:SharpRail.Plugins.UI.Kit"
             xmlns:local="using:SharpRail.UI.Panels"
             x:Class="SharpRail.UI.Panels.LanguagePanel">
  <UserControl.Styles>
    <Style Selector="Path.booting">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <local:LanguageServerIconConverter x:Key="LanguageMark" />
    <local:LanguageServerNameConverter x:Key="LanguageName" />
  </UserControl.Resources>
  <ScrollViewer x:Name="PaneScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel x:Name="PaneBody" Margin="16" Spacing="8">
    <TextBlock x:Name="Workspace" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
    <StackPanel x:Name="LanguageServersSection" Spacing="8">
      <TextBlock Text="Language servers" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Text="Diagnostics, navigation and refactoring for your project." FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
      <TextBlock x:Name="LifetimeNote" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
    <TextBlock x:Name="Status" Text="Reading language servers…" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" Margin="0,4" />
    <Border x:Name="AgentLspGuidance" Background="{x:Static kit:Ui.Elevated}" BorderBrush="{x:Static kit:Ui.Accent}" BorderThickness="2,0,0,0" Padding="8">
      <StackPanel Spacing="4">
        <TextBlock Text="Let your AI agent configure language servers" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="Missing libraries or include paths? Ask your agent to configure this workspace and restart its language server."
                   FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ListBox x:Name="Servers" Grid.IsSharedSizeScope="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{x:Static kit:Ui.Hover}" />
          <Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" />

        </Style>
        <Style Selector="ListBoxItem:selected Border#ServerRowSurface">
          <Setter Property="BorderBrush" Value="{x:Static kit:Ui.Accent}" />
        </Style>
        <Style Selector="Path#ServerBootSpinner, ContentControl#ServerStatusIcon, ContentControl#ServerLanguageIcon"><Setter Property="Margin" Value="0,0,8,0" /></Style>
        <Style Selector="Button#ServerSettingsAction, TextBlock#ServerDisclosure"><Setter Property="Margin" Value="8,0,0,0" /></Style>
        <!-- In a very narrow pane the header line keeps every column and tightens only its gaps. -->
        <ContainerQuery Name="ServerRow" Query="max-width:200">
          <Style Selector="Path#ServerBootSpinner, ContentControl#ServerStatusIcon, ContentControl#ServerLanguageIcon"><Setter Property="Margin" Value="0,0,2,0" /></Style>
          <Style Selector="Button#ServerSettingsAction, TextBlock#ServerDisclosure"><Setter Property="Margin" Value="2,0,0,0" /></Style>
        </ContainerQuery>
      </ListBox.Styles>
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:CompileBindings="False">
          <Border Name="ServerRowSurface" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="8,0,0,0" Container.Name="ServerRow" Container.Sizing="Width">
          <!-- One header line at every width: [status][icon][name][settings][Start/Retry], status, icon and action columns shared across rows; details sit under the name. -->
          <Grid RowDefinitions="Auto,Auto">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="ServerStatus" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="ServerIcon" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="ServerSettings" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="ServerAction" />
            </Grid.ColumnDefinitions>
            <Path Name="ServerBootSpinner" Classes.booting="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                  Width="16" Height="16" VerticalAlignment="Center"
                  Data="M 8,1 A 7,7 0 1 1 1,8" Stroke="{x:Static kit:Ui.Muted}" StrokeThickness="1.5"
                  RenderTransformOrigin="50%,50%" AutomationProperties.Name="{Binding StatusDescription}" ToolTip.Tip="{Binding StatusDescription}" />
            <ContentControl Name="ServerStatusIcon" AutomationProperties.Name="{Binding StatusDescription}" ToolTip.Tip="{Binding StatusDescription}" IsVisible="{Binding ShowStatusIcon}" Content="{Binding Icon}" VerticalAlignment="Center" />
            <ContentControl Grid.Column="1" Name="ServerLanguageIcon" Content="{Binding Server.Id, Converter={StaticResource LanguageMark}}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Name="ServerTitle" Text="{Binding}" ToolTip.Tip="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="3" Name="ServerSettingsAction" VerticalAlignment="Center" Content="{Binding SettingsIcon}" Click="SettingsClicked"
                    ToolTip.Tip="{Binding SettingsTooltip}" AutomationProperties.Name="Workspace settings"
                    Classes="quiet" Background="Transparent" BorderThickness="0" Padding="4" MinHeight="0" />
            <TextBlock Grid.Column="4" Name="ServerDisclosure" Text="{Binding Disclosure}" Foreground="{x:Static kit:Ui.Muted}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Name="ServerDetails" Spacing="4">
              <TextBlock Name="ServerNeeds" IsVisible="{Binding HasMissing}" Text="{Binding Needs}" Foreground="{x:Static kit:Ui.Danger}" TextWrapping="Wrap" />
              <TextBlock Name="ServerDetail" IsVisible="{Binding ShowDetail}" Text="{Binding Server.Detail}" Foreground="{Binding DetailBrush}" TextWrapping="Wrap" />
              <local:LanguageDependencyList Name="ServerDependencies" IsVisible="{Binding ShowDependencies}" Dependencies="{Binding Server.Dependencies}" />
              <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding ShowExit}">
                <Button Name="ServerExitDetailsAction" Content="{Binding ExitToggle}" Classes="link" Click="ExitDetailsClicked" />
                <Button Name="ServerExitCopyAction" Content="Copy details" Classes="link" Click="CopyExitClicked" />
              </StackPanel>
              <SelectableTextBlock Name="ServerExitText" IsVisible="{Binding ShowExitDetails}" Text="{Binding ExitDetails}"
                                   FontFamily="monospace" FontSize="11" TextWrapping="Wrap" Foreground="{x:Static kit:Ui.Muted}" />
              <Button Name="ServerLogsAction" Content="View logs" Classes="link" HorizontalAlignment="Left"
                      IsVisible="{Binding ShowLogs}" Click="LogsClicked" />
              <Button Name="ServerSourceAction" IsVisible="{Binding HasSource}" Classes="link" Click="SourceClicked"
                      HorizontalAlignment="Left" HorizontalContentAlignment="Left" >
                <TextBlock Text="{Binding Detection}" ToolTip.Tip="{Binding Detection}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </Button>
              <TextBlock Name="ServerProvenance" IsVisible="{Binding HasProvenance}" Text="{Binding Provenance}" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
              <TextBlock Name="ServerVersion" IsVisible="{Binding Expanded}" Text="{Binding Version}" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ComboBox x:Name="AddServer" PlaceholderText="Add language server…" HorizontalAlignment="Stretch" BorderThickness="0" Background="Transparent">
      <ComboBox.ItemTemplate>
        <DataTemplate x:CompileBindings="False">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ContentControl Content="{Binding Converter={StaticResource LanguageMark}}" />
            <TextBlock Text="{Binding Converter={StaticResource LanguageName}}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <WrapPanel Margin="0,8,0,0">
      <Button x:Name="Refresh" Content="Refresh" Margin="0,0,8,8" />
    </WrapPanel>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</UserControl>