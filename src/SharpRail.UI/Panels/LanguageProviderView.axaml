<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:kit="using:SharpRail.Plugins.UI.Kit" x:Class="SharpRail.UI.Panels.LanguageProviderView">
    <StackPanel x:Name="ProviderChoiceSection" Spacing="4" IsVisible="False">
      <TextBlock x:Name="ProviderChoiceHeading" Text="Language provider · all projects on this host" FontWeight="SemiBold" />
      <ComboBox x:Name="ProviderChoice" HorizontalAlignment="Stretch" SelectionChanged="ProviderChoiceChanged" />
      <Button x:Name="ApplyProviderChoice" Content="Apply" HorizontalAlignment="Left" IsEnabled="False" Click="ApplyProviderChoiceClicked" />
      <TextBlock Text="Only the selected providers handle these languages. Existing settings are preserved." FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
      <TextBlock x:Name="ProviderChoiceMessage" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
