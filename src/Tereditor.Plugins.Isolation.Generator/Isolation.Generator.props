<Project>
  <!--
    Imported by the projects the isolation generator writes into; each sets TereditorIsolation to runner, trusted-host or
    trusted-ui first. The pending list is one file for all of them (Security.SPEC.md, Calls across the boundary).
  -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Tereditor.Plugins.Isolation.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="TereditorIsolation" />
    <CompilerVisibleProperty Include="RootNamespace" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../Tereditor.Plugins.Api/isolation-pending.txt" Link="isolation-pending.txt" />
  </ItemGroup>
</Project>
