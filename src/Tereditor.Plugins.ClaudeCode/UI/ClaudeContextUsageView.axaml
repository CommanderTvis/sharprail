<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:Tereditor.Plugins.UI.Kit"
             x:Class="Tereditor.Plugins.ClaudeCode.UI.ClaudeContextUsageView"
             x:Name="ClaudeContextUsage">
  <!-- The baseline's state in one short line: measuring, when it was measured, or why it failed with a retry. -->
  <DockPanel x:Name="ClaudeContextStatus" Margin="8,4">
    <Button x:Name="ClaudeContextRetry" DockPanel.Dock="Right" Classes="link" Content="Retry" IsVisible="False" VerticalAlignment="Top" />
    <TextBlock x:Name="ClaudeContextMessage" FontSize="12" Foreground="{x:Static kit:Ui.Hint}" TextWrapping="Wrap" />
  </DockPanel>
</UserControl>
