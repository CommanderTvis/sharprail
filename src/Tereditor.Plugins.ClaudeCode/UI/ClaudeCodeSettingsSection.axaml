<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:Tereditor.Plugins.UI.Kit"
             x:Class="Tereditor.Plugins.ClaudeCode.UI.ClaudeCodeSettingsSection"
             x:Name="SettingsClaudeCode">
  <UserControl.Styles>
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{x:Static kit:Ui.Muted}" /></Style>
    <Style Selector="TextBlock.heading"><Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" /><Setter Property="FontSize" Value="13" /></Style>
  </UserControl.Styles>
  <StackPanel Spacing="16">
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" FontSize="15" Text="Claude Code" />
      <TextBlock Text="The Claude Code pane, terminal status and the offer to install tereditor's Claude Code plugin." />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Launch command" />
      <TextBlock Text="The command the launcher runs in a new terminal, flags included." />
      <DockPanel>
        <Button x:Name="ClaudeCommandBrowse" DockPanel.Dock="Right" Margin="4,0,0,0" Content="Browse…" />
        <TextBox x:Name="ClaudeCommandInput" PlaceholderText="claude" FontFamily="{x:Static kit:Ui.CodeFont}" AutomationProperties.Name="Claude Code launch command" />
      </DockPanel>
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Presentation" />
      <ComboBox x:Name="ClaudeMode" HorizontalAlignment="Stretch" AutomationProperties.Name="Claude Code presentation" />
      <TextBlock Text="Chat shows the conversation in an editor tab." />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Default model" />
      <AutoCompleteBox x:Name="ClaudeDefaultModel" PlaceholderText="Use CLI default" MinimumPrefixLength="0" FilterMode="Contains" AutomationProperties.Name="Claude Code default model" />
      <TextBlock Text="A model alias or full id. Blank uses Claude Code's default." />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Default effort" />
      <ComboBox x:Name="ClaudeDefaultEffort" HorizontalAlignment="Stretch" AutomationProperties.Name="Claude Code default effort" />
      <TextBlock Text="Applies to new launches. Per-launch choices override it." />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Default permission mode" />
      <ComboBox x:Name="ClaudePermissionMode" HorizontalAlignment="Stretch" AutomationProperties.Name="Claude Code default permission mode" />
      <TextBlock x:Name="ClaudePermissionModeNote" Text="Launch sessions with --permission-mode. The launcher's right-click menu overrides it for one run." />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Default advisor" />
      <ComboBox x:Name="ClaudeDefaultAdvisor" HorizontalAlignment="Stretch" AutomationProperties.Name="Claude Code default advisor" />
      <TextBlock Text="Launch sessions with --advisor. The launcher's right-click menu overrides it for one run." />
    </StackPanel>
    <CheckBox x:Name="ClaudeChrome">
      <StackPanel Spacing="2">
        <TextBlock Classes="heading" Text="Claude in Chrome: always enable" />
        <TextBlock Text="Launch sessions with --chrome. The launcher's right-click menu overrides it for one run." />
      </StackPanel>
    </CheckBox>
    <CheckBox x:Name="ClaudeDisableAgentView">
      <StackPanel Spacing="2">
        <TextBlock Classes="heading" Text="Start Claude Code without its own agent view" />
        <TextBlock Text="Launch sessions with the CLI's background-agent view off." />
      </StackPanel>
    </CheckBox>
    <CheckBox x:Name="ClaudeAppendSystemPrompt">
      <StackPanel Spacing="2">
        <TextBlock Classes="heading" Text="Tell Claude Code it is running in tereditor" />
        <TextBlock Text="Launch sessions with a short system prompt about the workspace and tereditor's tools. Pick its sections in the Claude Code pane's Context tab." />
      </StackPanel>
    </CheckBox>
  </StackPanel>
</UserControl>
