{
	"description": "tereditor terminal status tracking, notifications, code-intelligence reminders, diagnostics after edits and prompt-free read-only language tools",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/on-session-start.sh"
					}
				]
			},
			{
				"matcher": "startup|resume|clear|compact",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/code-intel.sh session",
						"timeout": 5
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/code-intel.sh subagent",
						"timeout": 5
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Grep|Glob|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/code-intel.sh pretool",
						"timeout": 5
					}
				]
			},
			{
				"matcher": "mcp__plugin_tereditor_tereditor__lsp_navigate|mcp__plugin_tereditor_tereditor__lsp_diagnostics|mcp__plugin_tereditor_tereditor__lsp_status|mcp__plugin_tereditor_tereditor__lsp_code_actions|mcp__plugin_tereditor_tereditor__lsp_rename|mcp__plugin_tereditor_tereditor__lsp_format",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/lsp-permission.sh",
						"timeout": 5
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/on-prompt-submit.sh"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh"
					}
				]
			},
			{
				"matcher": "Edit|Write|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/edit-diagnostics.sh",
						"timeout": 10
					}
				]
			}
		],
		"PostModelSwitch": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/on-model-switch.sh"
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/on-permission-request.sh"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/on-stop.sh"
					}
				]
			}
		],
		"StopFailure": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/on-stop-failure.sh"
					}
				]
			}
		]
	}
}
