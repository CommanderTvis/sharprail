<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console host: no web server, no window. It reaches only Host.Core; BoundaryChecks and the headless check fail on any UI reference. -->
  <Import Project="../../NativeAot.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tereditor-headless</AssemblyName>
    <RootNamespace>Tereditor.Host.Headless</RootNamespace>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="Tereditor.Checks" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Tereditor.Host.Core/Tereditor.Host.Core.csproj" />
  </ItemGroup>
</Project>
