<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:SharpRail.Plugins.UI.Kit"
             x:Class="SharpRail.Plugins.ClaudeCode.UI.ClaudeCodeSettingsSection"
             x:Name="SettingsClaudeCode">
  <UserControl.Styles>
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{x:Static kit:Ui.Muted}" /></Style>
    <Style Selector="TextBlock.heading"><Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" /><Setter Property="FontSize" Value="13" /></Style>
  </UserControl.Styles>
  <StackPanel Spacing="16">
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" FontSize="15" Text="Claude Code" />
      <TextBlock Text="The Claude Code pane, terminal status and the plugin offer — turn the plugin itself on or off from Settings › Plugins." />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Launch command" />
      <TextBlock Text="What the launcher types into a new terminal. A command line, so flags are welcome — pick an executable if claude is not on your PATH." />
      <DockPanel>
        <Button x:Name="ClaudeCommandBrowse" DockPanel.Dock="Right" Margin="4,0,0,0" Content="Browse…" />
        <TextBox x:Name="ClaudeCommandInput" PlaceholderText="claude" FontFamily="{x:Static kit:Ui.CodeFont}" AutomationProperties.Name="Claude Code launch command" />
      </DockPanel>
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Default model" />
      <TextBox x:Name="ClaudeDefaultModel" PlaceholderText="Use CLI default" AutomationProperties.Name="Claude Code default model" />
      <TextBlock Text="A model alias or full model id. Leave blank to use Claude Code's default." />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Presentation" />
      <ComboBox x:Name="ClaudeMode" HorizontalAlignment="Stretch" AutomationProperties.Name="Claude Code presentation" />
      <TextBlock Text="Terminal runs Claude Code's own interface in a terminal tab. Chat drives it headless and shows the conversation in an editor tab; presets a chat cannot honour, such as teleport and custom arguments, still start the terminal." />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Default effort" />
      <ComboBox x:Name="ClaudeDefaultEffort" HorizontalAlignment="Stretch" AutomationProperties.Name="Claude Code default effort" />
      <TextBlock Text="Applies to new SharpRail launches. Revived sessions restore their last used model and effort. Per-launch choices take precedence." />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Default permission mode" />
      <ComboBox x:Name="ClaudePermissionMode" HorizontalAlignment="Stretch" AutomationProperties.Name="Claude Code default permission mode" />
      <TextBlock x:Name="ClaudePermissionModeNote" Text="Passed as --permission-mode to sessions SharpRail starts. Claude Code's default leaves the flag off, so your own Claude settings decide. The launcher's right-click menu picks a mode for one run." />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Classes="heading" Text="Default advisor" />
      <ComboBox x:Name="ClaudeDefaultAdvisor" HorizontalAlignment="Stretch" AutomationProperties.Name="Claude Code default advisor" />
      <TextBlock Text="Passed as --advisor to sessions SharpRail starts. None leaves the flag off, so Claude Code's own advisor setting applies. The launcher's right-click menu picks one for a single run." />
    </StackPanel>
    <CheckBox x:Name="ClaudeChrome">
      <StackPanel Spacing="2">
        <TextBlock Classes="heading" Text="Claude in Chrome: always enable" />
        <TextBlock Text="Starts sessions SharpRail launches with --chrome. Off leaves the flag out so Claude Code's own setting applies; the launcher's right-click menu turns it on, or off, for one run." />
      </StackPanel>
    </CheckBox>
    <CheckBox x:Name="ClaudeDisableAgentView">
      <StackPanel Spacing="2">
        <TextBlock Classes="heading" Text="Start Claude Code without its own agent view" />
        <TextBlock Text="Parallel sessions are what SharpRail's workspaces and terminals are for, so a session started from here does not also open the CLI's own view of them. Applies to sessions SharpRail starts; one you type yourself is your own." />
      </StackPanel>
    </CheckBox>
    <CheckBox x:Name="ClaudeAppendSystemPrompt">
      <StackPanel Spacing="2">
        <TextBlock Classes="heading" Text="Tell Claude Code it is running in SharpRail" />
        <TextBlock Text="Sessions SharpRail starts append a short system prompt: that they run in a workspace rather than a bare shell, which SharpRail tools to reach for, and how to create worktrees the app lists. Turn it off to start sessions with Claude Code's own prompt only. Applies to new sessions; a resumed one keeps the prompt it began with." />
      </StackPanel>
    </CheckBox>
    <TextBlock Margin="28,-10,0,0" Text="Choose which sections it includes for a project in the Claude Code pane's Context tab; the text itself is not editable." />
    <TextBlock Text="While on: the Claude Code pane resolves the configuration that applies to a workspace, terminals are watched for a running agent, and SharpRail offers to install its Claude Code plugin. Configuration is only ever written after you approve the exact change." />
    <TextBlock Text="While off: no file under ~/.claude is read, the process table is not polled, and the host refuses these requests even if a client asks." />
  </StackPanel>
</UserControl>
