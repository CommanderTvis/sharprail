<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="using:SharpRail.Plugins.UI.Kit"
        x:Class="SharpRail.UI.Browser.ConnectWindow"
        Title="SharpRail"
        Background="{x:Static rendering:Ui.Workspace}" Foreground="{x:Static rendering:Ui.TextBrush}"
        FontFamily="{x:Static rendering:Ui.InterfaceFont}" FontSize="14" FontWeight="370">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="ConnectForm" Spacing="16" Width="360" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="8">
        <ContentControl x:Name="ConnectBrand" HorizontalAlignment="Left" />
        <TextBlock Text="Connect to a host" FontSize="24" />
        <TextBlock TextWrapping="Wrap" Foreground="{x:Static rendering:Ui.Muted}"
                   Text="This app is a client of a running SharpRail. Enter the host’s address and session token." />
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Text="Host address" Foreground="{x:Static rendering:Ui.Muted}" />
        <TextBox x:Name="ConnectAddress" PlaceholderText="localhost:54123" />
        <TextBlock Text="Session token" Foreground="{x:Static rendering:Ui.Muted}" />
        <TextBox x:Name="ConnectToken" PasswordChar="●" />
      </StackPanel>
      <TextBlock x:Name="ConnectError" IsVisible="False" TextWrapping="Wrap" Foreground="{x:Static rendering:Ui.Danger}" />
      <Button x:Name="ConnectSubmit" Classes="primary" Content="Connect" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button x:Name="ConnectScan" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
    </StackPanel>
  </ScrollViewer>
</Window>
