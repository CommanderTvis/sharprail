<Project>
  <Target Name="ValidateBrowserAotPolicy" BeforeTargets="PrepareForBuild" Condition="'$(SharpRailBrowserAot)' == 'true'">
    <Error Condition="'$(RunAOTCompilation)' != 'true' or '$(RunAOTCompilationAfterBuild)' != 'true'" Text="Browser selective AOT must apply consistently to Build and Publish." />
    <Error Condition="'$(PublishAot)' == 'true' or '$(AOTMode)' != 'LLVMOnlyInterp'" Text="Browser selective AOT requires the hybrid managed runtime." />
    <Error Condition="'$(PublishTrimmed)' != 'true' or '$(TrimMode)' != 'copy' or '$(WasmStripILAfterAOT)' != 'false'" Text="Browser selective AOT must preserve managed assemblies and IL." />
    <Error Condition="'$(JsonSerializerIsReflectionEnabledByDefault)' != 'true'" Text="Browser selective AOT requires JSON reflection." />
  </Target>
  <Target Name="KeepBrowserManagedAssemblies" BeforeTargets="PrepareForILLink" DependsOnTargets="_ComputeManagedAssemblyToLink" Condition="'$(SharpRailBrowserAot)' == 'true'">
    <ItemGroup>
      <TrimmerRootAssembly Include="@(ManagedAssemblyToLink->'%(Filename)')" RootMode="all" />
      <ManagedAssemblyToLink Update="@(ManagedAssemblyToLink)" TrimMode="copy" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)browser-preserved-assemblies.txt" Lines="@(ManagedAssemblyToLink->'%(Identity)|$(IntermediateLinkDir)%(Filename)%(Extension)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="VerifyBrowserManagedAssemblies" AfterTargets="ILLink" Condition="'$(SharpRailBrowserAot)' == 'true'">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/verify-preserved-assemblies.mjs&quot; &quot;$(IntermediateOutputPath)browser-preserved-assemblies.txt&quot;" />
  </Target>
  <!-- The assemblies compiled to WebAssembly ahead of time; every other assembly stays interpreted. The rationale for
       each is in SPEC.md ("Browser AOT assemblies"). Both targets below fail when the selected or compiled set drifts. -->
  <PropertyGroup>
    <BrowserAotAssemblies Condition="'$(BrowserAotAssemblies)' == ''">System.Private.CoreLib;Avalonia.Base;SharpRail.Scintilla;SkiaSharp;HarfBuzzSharp;Avalonia.Skia;Avalonia.HarfBuzz;Avalonia.Controls;Avalonia.Browser;SharpRail.UI;SharpRail.Plugins.UI.Kit;System.Text.Json;System.Linq;System.Collections;System.Text.RegularExpressions;TextMateSharp;Markdig;SharpRail.Host.Protocol;SharpRail.Host.Client;System.Runtime.InteropServices.JavaScript</BrowserAotAssemblies>
    <_BrowserAotList>;$(BrowserAotAssemblies);</_BrowserAotList>
    <!-- Bitcode files are named <assembly>.dll.bc. -->
    <_BrowserAotBitcodeList>;$(BrowserAotAssemblies.Replace(';', '.dll;')).dll;</_BrowserAotBitcodeList>
  </PropertyGroup>
  <Target Name="SelectBrowserAotAssemblies" BeforeTargets="_WasmAotCompileApp" Condition="'$(SharpRailBrowserAot)' == 'true'">
    <ItemGroup>
      <BrowserAotName Include="$(BrowserAotAssemblies)" />
      <BrowserAotAssembly Include="@(_WasmAssembliesInternal)" Condition="$(_BrowserAotList.Contains(';%(_WasmAssembliesInternal.Filename);'))" />
      <_WasmAssembliesInternal Update="@(_WasmAssembliesInternal)" Condition="!$(_BrowserAotList.Contains(';%(_WasmAssembliesInternal.Filename);'))">
        <AOT_InternalForceToInterpret>true</AOT_InternalForceToInterpret>
      </_WasmAssembliesInternal>
    </ItemGroup>
    <Error Condition="@(BrowserAotAssembly->Count()) != @(BrowserAotName->Count())" Text="Browser AOT expects $(BrowserAotAssemblies) but found @(BrowserAotAssembly->'%(Filename)')." />
  </Target>
  <Target Name="VerifyBrowserAotAssemblies" AfterTargets="_WasmAotCompileApp" Condition="'$(SharpRailBrowserAot)' == 'true'">
    <ItemGroup>
      <BrowserCompiledAotAssembly Include="@(_BitcodeFile)" Condition="$(_BrowserAotBitcodeList.Contains(';%(_BitcodeFile.Filename);'))" />
      <BrowserUnexpectedAotAssembly Include="@(_BitcodeFile)" Condition="!$(_BrowserAotBitcodeList.Contains(';%(_BitcodeFile.Filename);')) and '%(_BitcodeFile.Filename)' != 'aot-instances.dll'" />
    </ItemGroup>
    <Error Condition="@(BrowserCompiledAotAssembly->Count()) != @(BrowserAotName->Count()) or @(BrowserUnexpectedAotAssembly->Count()) != 0" Text="The browser AOT compilation must cover exactly $(BrowserAotAssemblies) plus shared generic instances; compiled @(_BitcodeFile->'%(Filename)')." />
  </Target>
</Project>
