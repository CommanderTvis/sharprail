<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="using:SharpRail.Plugins.UI.Kit">
  <Style Selector="ListBox.drawn-tree">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.drawn-tree ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="{x:Static kit:LayoutRoles.PanelRow}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ListBox.drawn-tree ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Hover}" />
  </Style>
  <!-- Fluent fills a selected list or combo row with the accent and keeps light text of its own, unreadable on it; selection is the theme's neutral selected fill. -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBoxItem:selected:pressed /template/ ContentPresenter, ComboBoxItem:selected /template/ ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter, ComboBoxItem:selected:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Selected}" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" />
  </Style>
  <Style Selector="Button, ToggleButton, CheckBox">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <!-- Fluent leaves a Button's vertical content alignment at Stretch, which draws the text of a fixed-height button at its top. -->
  <Style Selector="Button">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- Window controls of the Linux integrated header: flat, header-high, muted until hovered; Close turns red. -->
  <Style Selector="Button.caption-button">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="{x:Static kit:LayoutRoles.TopbarRow}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.caption-button Path">
    <Setter Property="Stroke" Value="{x:Static kit:Ui.Muted}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Button.caption-button:pointerover Path, Button.caption-button:pressed Path">
    <Setter Property="Stroke" Value="{x:Static kit:Ui.TextBrush}" />
  </Style>
  <Style Selector="Button.caption-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Hover}" />
  </Style>
  <Style Selector="Button.caption-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Selected}" />
  </Style>
  <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.caption-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Danger}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{x:Static kit:Ui.PrimaryFill}" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.OnPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.PrimaryFill}" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.OnPrimary}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.PrimaryFillHover}" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.OnPrimary}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.Accent}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.choice">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.PrimaryMuted}" />
    <Setter Property="BorderBrush" Value="{x:Static kit:Ui.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Elevated}" />
    <Setter Property="BorderBrush" Value="{x:Static kit:Ui.PrimaryMuted}" />
  </Style>
  <Style Selector="Button.card-accent:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.card-accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.PrimarySubtle}" />
  </Style>
  <!-- Hover colours of text buttons and the pane separator come from these styles, not pointer handlers. -->
  <Style Selector="Button.source-path TextBlock">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.Muted}" />
  </Style>
  <Style Selector="Button.source-path:pointerover TextBlock">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.Accent}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.row-action TextBlock">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.Muted}" />
  </Style>
  <Style Selector="Button.row-action.danger TextBlock">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.Hint}" />
  </Style>
  <Style Selector="Button.row-action:pointerover TextBlock">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" />
  </Style>
  <Style Selector="Button.row-action.danger:pointerover TextBlock">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.Danger}" />
  </Style>
  <Style Selector="Button.doc-link TextBlock">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" />
  </Style>
  <Style Selector="Button.doc-link:pointerover TextBlock">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.Accent}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector=":is(Border).pane-separator > Border">
    <Setter Property="Background" Value="{x:Static kit:Ui.BorderBrush}" />
  </Style>
  <Style Selector=":is(Border).pane-separator:pointerover > Border">
    <Setter Property="Background" Value="{x:Static kit:Ui.Accent}" />
  </Style>
  <Style Selector="FlyoutPresenter.chip-card">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Button:disabled, ToggleButton:disabled, CheckBox:disabled">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.ControlDisabledText}" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.ControlDisabledText}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.ControlDisabledFill}" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.ControlDisabledText}" />
  </Style>
  <Style Selector="ToggleButton:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Sidebar}" />
    <Setter Property="BorderBrush" Value="{x:Static kit:Ui.ControlDisabledBorder}" />
  </Style>
  <!-- Quiet scrollbars (see SPEC.md): a 6px transparent track whose thumb is invisible at rest, the border colour
       while its scroll viewer carries intent (hover, focus, recent scrolling) and muted under the pointer or a drag.
       QuietScroll supplies the intent class and the edge curtains; the resting thumb and inset are theme resources. -->
  <Styles.Resources>
    <ControlTheme x:Key="QuietScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="QuietScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="3" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource QuietScrollThumbRest}" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource QuietScrollPageButton}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource QuietScrollPageButton}" />
              </Track.IncreaseButton>
              <Thumb Name="thumb" Theme="{StaticResource QuietScrollThumb}" Background="{TemplateBinding Foreground}"
                     Margin="{DynamicResource QuietScrollThumbInset}" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^[Orientation=Vertical]">
        <Setter Property="Width" Value="6" />
      </Style>
      <Style Selector="^[Orientation=Vertical] /template/ Track#PART_Track">
        <Setter Property="IsDirectionReversed" Value="True" />
      </Style>
      <Style Selector="^[Orientation=Horizontal]">
        <Setter Property="Height" Value="6" />
      </Style>
      <Style Selector="^ /template/ Thumb#thumb">
        <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.15" />
          </Transitions>
        </Setter>
      </Style>
      <Style Selector="^:pointerover /template/ Thumb#thumb, ^ /template/ Thumb#thumb:pressed">
        <Setter Property="Margin" Value="0" />
      </Style>
      <Style Selector="^ /template/ Thumb#thumb:pointerover, ^ /template/ Thumb#thumb:pressed">
        <Setter Property="Background" Value="{x:Static kit:Ui.Muted}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="ScrollViewer:pointerover /template/ ScrollBar, ScrollViewer:focus-within /template/ ScrollBar, ScrollViewer.quiet-scroll-intent /template/ ScrollBar, ScrollBar:pointerover">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.BorderBrush}" />
  </Style>
  <Style Selector="ScrollViewer:pointerover /template/ ScrollBar /template/ Thumb#thumb, ScrollViewer:focus-within /template/ ScrollBar /template/ Thumb#thumb, ScrollViewer.quiet-scroll-intent /template/ ScrollBar /template/ Thumb#thumb">
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- Fluent paints the expanded header (a checked ToggleButton) with the primary fill and accent border; an expander header is plain text with a chevron and only a hover fill. -->
  <Style Selector="Expander">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <ToggleButton Classes="expander-header" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,2" MinHeight="0">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Path Classes="expander-chevron" Data="M 2,4 L 6,8 L 10,4" Width="12" Height="12" Stroke="{x:Static kit:Ui.Muted}"
                    StrokeThickness="1.5" VerticalAlignment="Center" />
              <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" IsVisible="{TemplateBinding IsExpanded}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Expander:not(:expanded) Path.expander-chevron">
    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
  </Style>
  <Style Selector="ToggleButton.expander-header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.expander-header /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.expander-header:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.expander-header:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.expander-header:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Hover}" />
  </Style>
  <!-- A flat option list in a flyout: no per-option frame, a hover fill only, and the popup flush with its anchor. -->
  <Style Selector="FlyoutPresenter.flat-list">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.option-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.option-row /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.option-row:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.option-row:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Hover}" />
  </Style>
  <Style Selector="Button.option-row.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Selected}" />
  </Style>
</Styles>
