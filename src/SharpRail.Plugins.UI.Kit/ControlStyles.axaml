<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="using:SharpRail.Plugins.UI.Kit">
  <Style Selector="Button, ToggleButton, CheckBox">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{x:Static kit:Ui.PrimaryFill}" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.OnPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.PrimaryFill}" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.OnPrimary}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.PrimaryFillHover}" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.OnPrimary}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.Accent}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.choice">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.PrimaryMuted}" />
    <Setter Property="BorderBrush" Value="{x:Static kit:Ui.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.setting-toggle">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BorderBrush" Value="{x:Static kit:Ui.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{x:Static kit:Ui.Elevated}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ToggleButton.setting-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Elevated}" />
    <Setter Property="BorderBrush" Value="{x:Static kit:Ui.BorderBrush}" />
  </Style>
  <Style Selector="ToggleButton.setting-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.setting-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Hover}" />
    <Setter Property="BorderBrush" Value="{x:Static kit:Ui.BorderBrush}" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Elevated}" />
    <Setter Property="BorderBrush" Value="{x:Static kit:Ui.PrimaryMuted}" />
  </Style>
  <Style Selector="Button.card-accent:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.card-accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.PrimarySubtle}" />
  </Style>
  <Style Selector="Button:disabled, ToggleButton:disabled, CheckBox:disabled">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.ControlDisabledText}" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Foreground" Value="{x:Static kit:Ui.ControlDisabledText}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.PrimaryDisabledFill}" />
    <Setter Property="Foreground" Value="{x:Static kit:Ui.ControlDisabledText}" />
  </Style>
  <Style Selector="ToggleButton:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Static kit:Ui.Sidebar}" />
    <Setter Property="BorderBrush" Value="{x:Static kit:Ui.ControlDisabledBorder}" />
  </Style>
</Styles>
