<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault><AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SharpRail.Scintilla/SharpRail.Scintilla.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="TextMateSharp" />
    <PackageReference Include="TextMateSharp.Grammars" />
    <InternalsVisibleTo Include="SharpRail.Checks" />
    <InternalsVisibleTo Include="SharpRail.UI" />
    <EmbeddedResource Include="Editor/Grammars/*.json" />
    <InternalsVisibleTo Include="SharpRail.Plugins.SpecDialect.UI" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <PropertyGroup>
    <FileIconsDirectory>$(MSBuildProjectDirectory)/obj/file-icons</FileIconsDirectory>
  </PropertyGroup>
  <Target Name="BuildFileIcons" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)/../../scripts/generate-file-icons.cs;$(MSBuildProjectDirectory)/../../scripts/build-file-icons.sh;$(MSBuildProjectDirectory)/../../scripts/build-file-icons.ps1;$(MSBuildProjectDirectory)/FileIcons/FileIconTable.g.cs"
          Outputs="$(FileIconsDirectory)/file.svg">
    <Exec Command="sh &quot;$(MSBuildProjectDirectory)/../../scripts/build-file-icons.sh&quot;" Condition="'$(OS)' != 'Windows_NT'" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/build-file-icons.ps1&quot;" Condition="'$(OS)' == 'Windows_NT'" />
  </Target>
  <Target Name="EmbedFileIcons" AfterTargets="BuildFileIcons" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildFileIcons">
    <ItemGroup>
      <FileIconsSvg Include="$(FileIconsDirectory)/*.svg" />
      <EmbeddedResource Include="@(FileIconsSvg)" LogicalName="SharpRail.Plugins.UI.Kit.FileIcons.%(FileIconsSvg.Filename)%(FileIconsSvg.Extension)" />
      <MaterialIconsSvg Include="$(FileIconsDirectory)/material/*.svg" />
      <EmbeddedResource Include="@(MaterialIconsSvg)" LogicalName="SharpRail.Plugins.UI.Kit.FileIcons.material.%(MaterialIconsSvg.Filename)%(MaterialIconsSvg.Extension)" />
    </ItemGroup>
  </Target>
</Project>
