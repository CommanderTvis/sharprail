<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault><AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SharpRail.Scintilla/SharpRail.Scintilla.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="TextMateSharp" />
    <PackageReference Include="TextMateSharp.Grammars" />
    <InternalsVisibleTo Include="SharpRail.Checks" />
    <InternalsVisibleTo Include="SharpRail.UI" />
    <EmbeddedResource Include="Editor/Grammars/*.json" />
    <InternalsVisibleTo Include="SharpRail.Plugins.SpecDialect.UI" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <Target Name="GenerateFileIcons" BeforeTargets="AssignTargetPaths">
    <Exec Command="sh &quot;$(MSBuildProjectDirectory)/../../scripts/build-file-icons.sh&quot;" Condition="'$(OS)' != 'Windows_NT'" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/build-file-icons.ps1&quot;" Condition="'$(OS)' == 'Windows_NT'" />
    <ItemGroup>
      <FileIconsSvg Include="../../.tools/file-icons/assets/file-icons/*.svg" />
      <EmbeddedResource Include="@(FileIconsSvg)" LogicalName="SharpRail.Plugins.UI.Kit.FileIcons.%(FileIconsSvg.Filename)%(FileIconsSvg.Extension)" />
    </ItemGroup>
  </Target>
</Project>
