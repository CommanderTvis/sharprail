<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:kit="using:SharpRail.Plugins.UI.Kit" x:Class="SharpRail.Plugins.UI.Kit.Visualization.ComparisonView"
            x:ClassModifier="internal" Name="VisualizationComparison" Spacing="8">
  <TextBlock x:Name="Heading" Foreground="{x:Static kit:Ui.TextBrush}" FontSize="14" TextWrapping="Wrap" />
  <UniformGrid x:Name="Options" Columns="1" />
</StackPanel>
