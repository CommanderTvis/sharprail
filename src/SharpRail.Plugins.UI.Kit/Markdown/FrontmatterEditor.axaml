<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpRail.Plugins.UI.Kit.Markdown.FrontmatterEditor">
  <StackPanel>
    <StackPanel x:Name="Rows" />
    <Button x:Name="FrontmatterAdd" Content="+ Add property" HorizontalAlignment="Left"
            MinHeight="28" Padding="4,2" />
  </StackPanel>
</UserControl>
