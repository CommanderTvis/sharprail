<UserControl xmlns:kit="using:SharpRail.Plugins.UI.Kit"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpRail.Plugins.UI.Kit.Markdown.FrontmatterEditor">
  <StackPanel>
    <StackPanel x:Name="Rows" Grid.IsSharedSizeScope="True" />
    <Button x:Name="FrontmatterAdd" Content="+ Add property" Foreground="{x:Static kit:Ui.Muted}" HorizontalAlignment="Left"
            MinHeight="0" Padding="4,2" FontSize="12" Background="Transparent" BorderThickness="0" />
  </StackPanel>
</UserControl>
