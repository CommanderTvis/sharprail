<UserControl xmlns:kit="using:SharpRail.Plugins.UI.Kit"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpRail.Plugins.UI.Kit.Markdown.FrontmatterMapping">
  <StackPanel Grid.IsSharedSizeScope="True">
    <StackPanel x:Name="Entries" />
    <Button x:Name="FrontmatterMapAdd" Content="+ Add entry" Foreground="{x:Static kit:Ui.Muted}" HorizontalAlignment="Left"
            MinHeight="0" Padding="4,2" FontSize="12" Background="Transparent" BorderThickness="0" />
  </StackPanel>
</UserControl>
