<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpRail.Plugins.UI.Kit.Markdown.FrontmatterMapping">
  <StackPanel>
    <StackPanel x:Name="Entries" />
    <Button x:Name="FrontmatterMapAdd" Content="+ Add entry" HorizontalAlignment="Left"
            MinHeight="28" Padding="4,2" />
  </StackPanel>
</UserControl>
