<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:kit="using:SharpRail.Plugins.UI.Kit" x:Class="SharpRail.Plugins.UI.Kit.AccountUsageWindow"
            x:ClassModifier="internal" Spacing="2">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <TextBlock x:Name="Label" Foreground="{x:Static kit:Ui.TextBrush}" FontSize="13" />
    <TextBlock x:Name="Percent" Grid.Column="1" Foreground="{x:Static kit:Ui.TextBrush}" FontSize="13" />
  </Grid>
  <ProgressBar x:Name="Usage" Minimum="0" Maximum="100" Height="4" MinHeight="4" CornerRadius="2" Background="{x:Static kit:Ui.Hover}" />
  <TextBlock x:Name="Reset" Foreground="{x:Static kit:Ui.Hint}" FontSize="12" />
</StackPanel>
