<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:SharpRail.Plugins.UI.Kit" xmlns:local="using:SharpRail.Plugins.Tailscale.UI" x:Class="SharpRail.Plugins.Tailscale.UI.TailscaleSettingsView" x:ClassModifier="internal">
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="12">
    <TextBlock Text="Tailscale pairing" FontWeight="SemiBold" Foreground="{x:Static kit:Ui.TextBrush}" />
    <TextBlock Text="Clients can find this host on your tailnet. Approve a new device only when its pairing code matches the code on that device." TextWrapping="Wrap" Foreground="{x:Static kit:Ui.Muted}" />
    <TextBlock x:Name="PairingStatus" Text="Checking…" TextWrapping="Wrap" />
    <TextBlock x:Name="PairingName" TextWrapping="Wrap" />
    <TextBlock Text="Waiting for approval" FontWeight="SemiBold" />
    <ItemsControl x:Name="PairingPending">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:TailscaleApprovalRow">
          <StackPanel Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Code}" FontFamily="{x:Static kit:Ui.CodeFont}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Approve" Command="{Binding Approve}" />
              <Button Content="Decline" Command="{Binding Decline}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="Remembered devices" FontWeight="SemiBold" />
    <ItemsControl x:Name="PairingApproved">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:TailscaleApprovalRow">
          <StackPanel Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" />
            <Button Content="Revoke access" Command="{Binding Revoke}" HorizontalAlignment="Left" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
