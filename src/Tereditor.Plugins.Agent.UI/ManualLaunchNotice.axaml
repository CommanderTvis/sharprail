<Border xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="using:Tereditor.Plugins.UI.Kit"
        x:Class="Tereditor.Plugins.Agent.UI.ManualLaunchNotice"
        Name="TerminalManualLaunchNotice" IsVisible="False">
  <TextBlock FontSize="11" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap"
             Text="Manual launch: tereditor does not add the launcher's settings, tools or prompt appendix. Use the workspace's agent launcher to apply them."
             ToolTip.Tip="Typing claude or codex directly does not apply tereditor's launcher configuration or prompt appendix. Already installed hooks and separately configured MCP or IDE connections may still work. Launcher settings control what UI launches receive." />
</Border>
