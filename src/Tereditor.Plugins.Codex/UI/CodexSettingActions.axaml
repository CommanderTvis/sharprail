<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:kit="using:SharpRail.Plugins.UI.Kit"
            x:Class="SharpRail.Plugins.Codex.UI.CodexSettingActions" x:ClassModifier="internal"
            Orientation="Horizontal" Spacing="4">
  <TextBlock x:Name="EditAsFile" Text="EDIT AS A FILE" FontSize="10" FontWeight="SemiBold"
             Foreground="{x:Static kit:Ui.Hint}" VerticalAlignment="Center" />
  <ContentControl x:Name="Remove" />
</StackPanel>
