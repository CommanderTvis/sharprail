<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="using:Tereditor.Plugins.UI.Kit"
             xmlns:local="using:Tereditor.UI.Panels"
             x:Class="Tereditor.UI.Panels.LanguageDependencyList">
  <ItemsControl Name="DependencyRows">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="local:LanguageDependencyList+DependencyRow">
        <StackPanel Spacing="2">
          <StackPanel.Styles><Style Selector="Button.link"><Setter Property="Padding" Value="0,2" /></Style></StackPanel.Styles>
          <kit:LinkedTextBlock Name="DependencyState" IsVisible="{Binding ShowText}" Source="{Binding Text}" Foreground="{Binding Brush}" FontSize="12" TextWrapping="Wrap" />
          <kit:LinkedTextBlock Name="DependencyHint" IsVisible="{Binding Missing}" Source="{Binding Hint}" FontSize="12" Foreground="{x:Static kit:Ui.Muted}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" TextElement.FontSize="12">
            <Button Name="DependencyUsePath" Content="Use path…" Classes="link" Click="UseDependencyPathClicked" IsVisible="{Binding CanChange}"
                    ToolTip.Tip="Choose an existing executable outside the workspace. Every language server uses it instead of PATH" />
            <Button Name="DependencyClearPath" Content="Clear path" Classes="link" Click="ClearDependencyPathClicked" IsVisible="{Binding CanClear}"
                    ToolTip.Tip="Find it on PATH again" />
            <Button Name="DependencyCopyHint" Content="Copy install hint" Classes="link" Click="CopyDependencyHintClicked" IsVisible="{Binding Missing}" />
          </StackPanel>
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
