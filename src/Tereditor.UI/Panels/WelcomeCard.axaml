<Button xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SharpRail.UI.Panels.WelcomeCard"
        Width="220" Height="150" Padding="16" CornerRadius="4" BorderThickness="1"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <Grid RowDefinitions="*,Auto">
    <ContentControl x:Name="Icon" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <StackPanel Grid.Row="1" Spacing="2">
      <TextBlock x:Name="Title" FontSize="16" />
      <TextBlock x:Name="Subtitle" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Button>
