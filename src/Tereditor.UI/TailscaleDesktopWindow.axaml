<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="using:SharpRail.Plugins.UI.Kit" x:Class="SharpRail.UI.TailscaleDesktopWindow" x:ClassModifier="internal"
        Background="{x:Static kit:Ui.Workspace}" Foreground="{x:Static kit:Ui.TextBrush}"
        FontFamily="{x:Static kit:Ui.InterfaceFont}" FontSize="14" Title="Connect over Tailscale" Width="460" Height="540" MinWidth="360" MinHeight="400">
  <ScrollViewer><ContentControl x:Name="TailscaleConnectBody" Margin="24" /></ScrollViewer>
</Window>
