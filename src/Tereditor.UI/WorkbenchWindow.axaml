<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="using:Tereditor.Plugins.UI.Kit"
        xmlns:local="using:Tereditor.UI"
        xmlns:notifications="using:Tereditor.UI.Rendering"
        x:Class="Tereditor.UI.WorkbenchWindow"
        Title="tereditor" Width="1440" Height="920" MinWidth="390" MinHeight="540"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="{x:Static rendering:LayoutRoles.TopbarRow}"
        Background="{x:Static rendering:Ui.Workspace}" Foreground="{x:Static rendering:Ui.Muted}"
        FontFamily="{x:Static rendering:Ui.InterfaceFont}" FontWeight="370">
  <Window.Styles>
    <Style Selector="Border.project-tab-current">
      <Setter Property="Background" Value="{x:Static rendering:Ui.PrimarySoft}" />
    </Style>
    <Style Selector="Button.project-tab-open">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button#WorkspaceSelect">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <!-- The Projects rail's edge pill: an accent pill centred over the rows, pointing to the focused row scrolled out of view. -->
    <Style Selector="Button.rail-edge-pill">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="8,0,12,0" />
      <Setter Property="Margin" Value="8,4,16,4" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rail-edge-pill.above ContentControl.rail-edge-chevron">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="Border#ActiveWorkspaceTab">
      <Setter Property="Margin" Value="4,8,4,8" />
    </Style>
    <Style Selector="TextBlock.workspace-description">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="3" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.header-label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Segments are separated by space alone: no hairlines, an 8px inset plus the pills' own padding. -->
    <Style Selector="Border.location-segment">
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.location-caption">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{x:Static rendering:Ui.Hint}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Every value rests muted in one style and brightens on hover or while its menu is open. -->
    <Style Selector="Button.location-pill">
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{x:Static rendering:Ui.Muted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.location-pill:pointerover, Button.location-pill.open">
      <Setter Property="Foreground" Value="{x:Static rendering:Ui.TextBrush}" />
    </Style>
    <Style Selector="Button.location-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Static rendering:Ui.Hover}" />
      <Setter Property="Foreground" Value="{x:Static rendering:Ui.TextBrush}" />
    </Style>
    <Style Selector="Button.location-pill.open /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{x:Static rendering:Ui.Selected}" />
      <Setter Property="Foreground" Value="{x:Static rendering:Ui.TextBrush}" />
    </Style>
    <!-- The chevron is hidden at rest and appears on hover, keyboard focus or while open. -->
    <Style Selector="Button.location-pill ContentControl.location-chevron">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.location-pill:pointerover ContentControl.location-chevron, Button.location-pill:focus-visible ContentControl.location-chevron, Button.location-pill.open ContentControl.location-chevron">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- One icon column for every field's value: the project badge, the workspace and branch icons, Remote's, the Host's. -->
    <Style Selector="ContentControl.location-icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="Border.location-initial">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{x:Static rendering:Ui.Selected}" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
  </Window.Styles>
  <LayoutTransformControl x:Name="ZoomRoot" LayoutTransform="{DynamicResource InterfaceZoom}">
  <Grid x:Name="WorkbenchRoot" RowDefinitions="40,*,Auto,Auto">
    <Border x:Name="WindowTitleBar" Background="{x:Static rendering:Ui.Header}"
            BorderBrush="{x:Static rendering:Ui.BorderBrush}" BorderThickness="0,0,1,1">
      <LayoutTransformControl x:Name="HeaderZoom">
      <Grid x:Name="MainHeader" ColumnDefinitions="*,Auto" Background="Transparent">
        <local:LocationStrip x:Name="LocationBar" ClipToBounds="True">
          <Border x:Name="ProjectSegment" Classes="location-segment" Width="200" Padding="0">
            <Grid RowDefinitions="14,20" VerticalAlignment="Center">
              <TextBlock Classes="location-caption tr-text-metadata" Text="Project" />
              <Button x:Name="ScopeProject" Grid.Row="1" Classes="location-pill tr-title-section">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="location-initial">
                    <TextBlock x:Name="ProjectInitial" Classes="tr-text-caption" Foreground="{x:Static rendering:Ui.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock x:Name="ProjectLabel" Grid.Column="1" Text="…" Classes="header-label tr-title-section" />
                  <ContentControl x:Name="ProjectChevron" Grid.Column="2" Classes="location-chevron" Margin="4,0,0,0" />
                </Grid>
              </Button>
            </Grid>
          </Border>
          <Border x:Name="BranchSegment" Classes="location-segment" Width="360" IsVisible="False">
            <!-- Two captioned blocks side by side: the branch pill, then the remote's sync state with the one action it offers. -->
            <!-- The remote block takes the rest of the segment, so what it shows never widens it. -->
            <Grid x:Name="BranchColumns" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
              <Grid RowDefinitions="14,20">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Classes="location-caption tr-text-metadata" Text="Branch" />
                  <TextBlock x:Name="ScopeBase" Classes="location-caption tr-text-metadata" Margin="0" />
                </StackPanel>
                <Button x:Name="ScopeBranch" Grid.Row="1" MinWidth="96" Classes="location-pill tr-title-section">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <ContentControl x:Name="BranchIcon" Classes="location-icon" />
                    <TextBlock x:Name="BranchLabel" Grid.Column="1" Classes="header-label tr-title-section" />
                    <ContentControl x:Name="BranchChevron" Grid.Column="2" Classes="location-chevron" Margin="4,0,0,0" />
                  </Grid>
                </Button>
              </Grid>
              <Grid x:Name="RemoteBlock" Grid.Column="1" RowDefinitions="14,20" Margin="8,0,0,0" MinWidth="200" ClipToBounds="True" IsVisible="False">
                <!-- Captioned by the branch it pushes to (origin/<branch>); "Remote" only while there is none to name. -->
                <TextBlock x:Name="RemoteCaption" Classes="location-caption tr-text-metadata" Text="Remote" />
                <DockPanel x:Name="RemoteRow" Grid.Row="1" Height="20" Margin="8,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </Border>
          <!-- Holds the Branch segment's slot while it is hidden (Project Home, no repository), so nothing else moves. -->
          <Border x:Name="BranchReserve" Width="360" IsHitTestVisible="False" />
        </local:LocationStrip>
        <StackPanel x:Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <!-- The host's own state is a captioned block like the location's: the listener's mark and the connection state, each the
               plain server glyph in the icon column beside its text. It is gone while neither shows. -->
          <Grid x:Name="HostSegment" RowDefinitions="14,20" VerticalAlignment="Center">
            <TextBlock Classes="location-caption tr-text-metadata" Text="Host" />
            <StackPanel Grid.Row="1" Orientation="Horizontal">
              <StackPanel x:Name="HostListeningMark" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="False"
                          AutomationProperties.Name="Host listening">
                <ContentControl x:Name="HostListeningIcon" Classes="location-icon" />
                <TextBlock Text="Listening" Classes="header-label tr-title-section" />
              </StackPanel>
              <Button x:Name="ConnectionButton" Classes="location-pill tr-title-section" IsHitTestVisible="False" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <ContentControl x:Name="ConnectionIcon" Classes="location-icon" />
                  <TextBlock x:Name="ConnectionStatus" Text="Connecting" Classes="header-label tr-title-section" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Button x:Name="SettingsButton" Width="32" Height="32" Padding="0"
                  Background="Transparent" BorderThickness="0" CornerRadius="0"
                  ToolTip.Tip="Settings (⌘,)" AutomationProperties.Name="Settings (⌘,)" />
        </StackPanel>
      </Grid>
      </LayoutTransformControl>
    </Border>
    <TextBlock x:Name="WorkspaceError" Grid.Row="2" FontSize="12" Margin="12,4"
               Foreground="{x:Static rendering:Ui.Danger}" TextWrapping="Wrap" IsVisible="False"
               Classes="header-label" />
    <!-- A phone-sized workbench moves between its pages from a bar at the thumb's end of the screen. -->
    <Border x:Name="PageBar" Grid.Row="3" IsVisible="False" Height="56" Background="{x:Static rendering:Ui.Header}"
            BorderBrush="{x:Static rendering:Ui.BorderBrush}" BorderThickness="0,1,0,0">
      <Grid x:Name="PageBarItems" ColumnDefinitions="*,*,*,*" />
    </Border>
    <Border x:Name="QuitHintOverlay" Grid.Row="1" ZIndex="31" IsVisible="False" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,12,12,24" Padding="16,12"
            Background="{x:Static rendering:Ui.Elevated}" BorderBrush="{x:Static rendering:Ui.BorderBrush}"
            BorderThickness="1" CornerRadius="4" AutomationProperties.LiveSetting="Assertive">
      <TextBlock x:Name="QuitHintMessage" Foreground="{x:Static rendering:Ui.TextBrush}" FontSize="14" TextWrapping="Wrap" />
    </Border>
    <!-- The switch's busy line is an overlay on the content's top edge: it takes no room, so it cannot move the status area. -->
    <Border x:Name="StatusBusy" Grid.Row="1" ZIndex="29" Height="2" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
            Background="{x:Static rendering:Ui.Accent}" />
    <StackPanel Grid.Row="1" ZIndex="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Spacing="8">
    <notifications:ToastStack x:Name="ToastStack" Width="356" />
    <Border x:Name="GestureToast" IsVisible="False" Width="356"
            Background="{x:Static rendering:Ui.Elevated}" BorderBrush="{x:Static rendering:Ui.BorderBrush}"
            BorderThickness="0,1,1,1" CornerRadius="4" ClipToBounds="True">
      <Grid ColumnDefinitions="4,*">
        <Border Background="{x:Static rendering:Ui.Accent}" />
        <Grid Grid.Column="1" ColumnDefinitions="*,24" Margin="12">
          <TextBlock x:Name="GestureToastMessage" Text="The layout changed. Your drag was canceled."
                     Foreground="{x:Static rendering:Ui.Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,8,0" />
          <Button x:Name="DismissGestureToast" Grid.Column="1" Width="24" Height="24" Margin="0,-4,-4,0"
                  VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="0"
                  AutomationProperties.Name="Dismiss" />
        </Grid>
      </Grid>
    </Border>
    </StackPanel>
    <local:OverlayHost x:Name="Overlay" Grid.RowSpan="4" />
  </Grid>
  </LayoutTransformControl>
</Window>
