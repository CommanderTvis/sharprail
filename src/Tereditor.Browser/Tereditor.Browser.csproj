<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Not locked: the browser-wasm restore resolves WebAssembly runtime and workload packs (wasm-tools) that vary with the installed workload manifest, so a lock cannot be reproduced from nuget.org alone. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Tereditor.UI</AssemblyName>
    <RootNamespace>Tereditor.UI</RootNamespace>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <DefineConstants>$(DefineConstants);BROWSER</DefineConstants>
    <DefineConstants Condition="'$(BrowserChecks)' == 'true'">$(DefineConstants);BROWSER_CHECKS</DefineConstants>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmccFlags>$(EmccFlags) -Wno-version-check</EmccFlags>
    <TereditorBrowserAot Condition="'$(TereditorBrowserAot)' == '' and '$(Configuration)' == 'Release'">true</TereditorBrowserAot>
    <TereditorBrowserAot Condition="'$(TereditorBrowserAot)' == ''">false</TereditorBrowserAot>
    <RunAOTCompilation>$(TereditorBrowserAot)</RunAOTCompilation>
    <RunAOTCompilationAfterBuild>$(TereditorBrowserAot)</RunAOTCompilationAfterBuild>
    <PublishTrimmed Condition="'$(TereditorBrowserAot)' == 'true'">true</PublishTrimmed>
    <TrimMode>copy</TrimMode>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer Condition="'$(TereditorBrowserAot)' == 'true' and '$(TrimMode)' == 'copy'">false</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings Condition="'$(TereditorBrowserAot)' == 'true' and '$(TrimMode)' == 'copy'">true</SuppressTrimAnalysisWarnings>
    <TrimmerRemoveSymbols>false</TrimmerRemoveSymbols>
    <WasmStripILAfterAOT>false</WasmStripILAfterAOT>
    <AOTMode>LLVMOnlyInterp</AOTMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableThreads>true</WasmEnableThreads>
    <WasmGenerateAppBundle>true</WasmGenerateAppBundle>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <WasmMainHTMLPath>wwwroot/index.html</WasmMainHTMLPath>
    <WasmAppDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/net10.0-browser/AppBundle</WasmAppDir>
    <WasmNativeDebugSymbols Condition="'$(Configuration)' == 'Release'">false</WasmNativeDebugSymbols>
    <!-- Release has no browser debugger: the native runtime omits the debugger component and the boot config lists no .pdb files (Chromium and Firefox download them at start otherwise). -->
    <WasmDebugLevel Condition="'$(Configuration)' == 'Release'">0</WasmDebugLevel>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <UiSources>../Tereditor.UI/</UiSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../tests/Tereditor.Browser.Checks/BrowserChecks.cs" Condition="'$(BrowserChecks)' == 'true'" />
    <Compile Include="../../tests/Tereditor.Browser.Checks/BrowserChecks.LocalApproval.cs" Condition="'$(BrowserChecks)' == 'true'" />
    <Compile Include="../../tests/Tereditor.Browser.Checks/BrowserChecks.Pointer.cs" Condition="'$(BrowserChecks)' == 'true'" />
    <Compile Include="../../tests/Tereditor.Browser.Checks/BrowserChecks.Settings.cs" Condition="'$(BrowserChecks)' == 'true'" />
    <Compile Include="../../tests/Tereditor.Browser.Checks/BrowserChecks.Prose.cs" Condition="'$(BrowserChecks)' == 'true'" />
    <Compile Include="../../tests/Tereditor.Browser.Checks/BrowserChecks.Mermaid.cs" Condition="'$(BrowserChecks)' == 'true'" />
    <Compile Include="../../tests/Tereditor.Browser.Checks/BrowserChecks.Phone.cs" Condition="'$(BrowserChecks)' == 'true'" />
    <Compile Include="../../tests/Tereditor.Browser.Checks/BrowserChecks.Perf.cs" Condition="'$(BrowserChecks)' == 'true'" />
    <Compile Include="$(UiSources)**/*.cs" Exclude="$(UiSources)bin/**;$(UiSources)obj/**;$(UiSources)Program.cs;$(UiSources)Terminal/LoopbackTerminals.cs;$(UiSources)Panels/HostSettings.cs" LinkBase="UI" />
    <AvaloniaXaml Include="$(UiSources)**/*.axaml" Exclude="$(UiSources)bin/**;$(UiSources)obj/**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="$(UiSources)Assets/**" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Tereditor.Host.Core/Tereditor.Host.Core.csproj" />
    <ProjectReference Include="../Tereditor.Host.Client/Tereditor.Host.Client.csproj" />
    <ProjectReference Include="../Tereditor.Scintilla/Tereditor.Scintilla.csproj" />
    <ProjectReference Include="../Ghostty.Avalonia/Ghostty.Avalonia.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Api.UI/Tereditor.Plugins.Api.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.UI.Kit/Tereditor.Plugins.UI.Kit.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.SpecDialect/UI/Tereditor.Plugins.SpecDialect.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Blueprint/UI/Tereditor.Plugins.Blueprint.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Env/UI/Tereditor.Plugins.Env.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.GitHub/UI/Tereditor.Plugins.GitHub.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Epub/UI/Tereditor.Plugins.Epub.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.ClaudeCode/UI/Tereditor.Plugins.ClaudeCode.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Discord/UI/Tereditor.Plugins.Discord.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.BranchGraph/UI/Tereditor.Plugins.BranchGraph.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Review/UI/Tereditor.Plugins.Review.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Processes/UI/Tereditor.Plugins.Processes.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Visualize/UI/Tereditor.Plugins.Visualize.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Codex/UI/Tereditor.Plugins.Codex.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Omp/UI/Tereditor.Plugins.Omp.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Pi/UI/Tereditor.Plugins.Pi.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Acp/UI/Tereditor.Plugins.Acp.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Providers/UI/Tereditor.Plugins.Providers.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.AirGateway/UI/Tereditor.Plugins.AirGateway.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.AirContext/UI/Tereditor.Plugins.AirContext.UI.csproj" />
    <ProjectReference Include="../Tereditor.Plugins.Tailscale/UI/Tereditor.Plugins.Tailscale.UI.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Browser" />
    <PackageReference Include="Microsoft.NET.WebAssembly.Threading" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <!-- The browser supplies the WASM PDFium build. -->
    <PackageReference Include="bblanchon.PDFium.Linux" ExcludeAssets="all" />
    <PackageReference Include="bblanchon.PDFium.macOS" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <WasmOptConfigurationFlags Include="--enable-nontrapping-float-to-int" />
    <!-- The post-link wasm-opt pass otherwise only rewrites features; -Oz shrinks the AOT code, which the transfer size is mostly made of. -->
    <WasmOptConfigurationFlags Include="-Oz" Condition="'$(Configuration)' == 'Release' and '$(TereditorWasmOz)' != 'false'" />
    <NativeFileReference Include="obj/wasm-native/GhosttyAvaloniaVt.a" />
  </ItemGroup>
  <Import Project="BrowserAot.targets" />
  <Target Name="CompressBrowserBundle" AfterTargets="_WasmBuildAppCore" Condition="'$(Configuration)' == 'Release' and '$(WasmGenerateAppBundle)' == 'true'">
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; run --file &quot;$(MSBuildProjectDirectory)/../../scripts/browser-compress.cs&quot; -- &quot;$(WasmAppDir)&quot;" />
  </Target>
  <ItemGroup>
    <WasmNativeSource Include="../Ghostty.Avalonia/Native/GhosttyVt.c;../Ghostty.Avalonia/Native/Wasm.patch;../../scripts/wasm-native.sh;../../mise.lock;../../mise.browser.lock" />
  </ItemGroup>
  <Target Name="BuildBrowserNative" BeforeTargets="PrepareForBuild"
          Inputs="@(WasmNativeSource)" Outputs="obj/wasm-native/GhosttyAvaloniaVt.a">
    <Exec EnvironmentVariables="MISE_ENV=browser" Command="$(MiseRun) sh &quot;$(MSBuildProjectDirectory)/../../scripts/wasm-native.sh&quot;" />
  </Target>
  <!-- The browser's own Tailscale node: deployed under tailscale/ but never loaded until the user downloads it. -->
  <ItemGroup>
    <TailscaleWasmSource Include="Tailscale.Wasm/go.mod;Tailscale.Wasm/go.sum;Tailscale.Wasm/main.go;../../scripts/build-tailscale-wasm.sh;../../scripts/tailscale-go.sh" />
  </ItemGroup>
  <Target Name="BuildTailscaleWasm" BeforeTargets="PrepareForBuild"
          Inputs="@(TailscaleWasmSource)" Outputs="obj/tailscale-wasm/manifest.json">
    <Exec EnvironmentVariables="MISE_ENV=browser" Command="$(MiseRun) sh &quot;$(MSBuildProjectDirectory)/../../scripts/build-tailscale-wasm.sh&quot;" />
  </Target>
  <Target Name="IncludeTailscaleWasm" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildTailscaleWasm">
    <ItemGroup>
      <TailscaleWasmAsset Include="obj/tailscale-wasm/**/*" />
      <WasmExtraFilesToDeploy Include="@(TailscaleWasmAsset)" TargetPath="tailscale/%(TailscaleWasmAsset.RecursiveDir)%(TailscaleWasmAsset.Filename)%(TailscaleWasmAsset.Extension)" />
    </ItemGroup>
  </Target>
  <!-- The vendored assets come from the pnpm lockfile, the PDFium pin, the licence files and the tab's Pi agent sources. -->
  <ItemGroup>
    <BrowserAssetSource Include="pnpm-lock.yaml;package.json;tabpi/**;../../scripts/browser-assets.cs;../../mise.browser.lock;../../LICENSE.md;../../NOTICE;../../THIRD-PARTY-NOTICES.md;../../licenses/**;licenses/**;../Ghostty.Avalonia/licenses/**;../Tereditor.Scintilla/licenses/**;../*/NOTICE.md" />
  </ItemGroup>
  <Target Name="StageBrowserAssets" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildBrowserNative"
          Inputs="@(BrowserAssetSource)" Outputs="wwwroot/vendor/PDFium-LICENSE">
    <Exec EnvironmentVariables="MISE_ENV=browser" Command="$(MiseRun) &quot;$(DOTNET_HOST_PATH)&quot; run --file &quot;$(MSBuildProjectDirectory)/../../scripts/browser-assets.cs&quot;" />
  </Target>
  <Target Name="IncludeBrowserAssets" BeforeTargets="PrepareForBuild" DependsOnTargets="StageBrowserAssets">
    <ItemGroup>
      <BrowserAsset Include="wwwroot/**/*" />
      <WasmExtraFilesToDeploy Include="@(BrowserAsset)" TargetPath="%(BrowserAsset.RecursiveDir)%(BrowserAsset.Filename)%(BrowserAsset.Extension)" />
    </ItemGroup>
  </Target>
  <Target Name="UseBrowserBinaryen" AfterTargets="_SetupEmscripten">
    <Exec Command="sh &quot;$(MSBuildProjectDirectory)/../../scripts/tool&quot; binaryen" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="BrowserBinaryen" />
    </Exec>
    <ItemGroup>
      <EmscriptenEnvVars Remove="@(EmscriptenEnvVars)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('DOTNET_EMSCRIPTEN_BINARYEN_ROOT=')) Or $([System.String]::Copy('%(Identity)').StartsWith('PATH='))" />
      <EmscriptenEnvVars Include="DOTNET_EMSCRIPTEN_BINARYEN_ROOT=$(BrowserBinaryen)" />
      <EmscriptenEnvVars Include="PATH=$(BrowserBinaryen)/bin$(_PathSeparator)$(_EmscriptenPrependPATHProperty)$(_PathSeparator)$([MSBuild]::Escape($(PATH)))" />
    </ItemGroup>
  </Target>
  <Target Name="UseAvaloniaImplementationAssemblies" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <AvaloniaReferenceAssembly Include="@(ReferencePath->WithMetadataValue('NuGetPackageId', 'Avalonia'))" />
      <ReferencePath Remove="@(AvaloniaReferenceAssembly)" />
      <ReferencePath Include="@(AvaloniaReferenceAssembly->Replace('/ref/', '/lib/')->Replace('\ref\', '\lib\'))" />
    </ItemGroup>
  </Target>
</Project>
