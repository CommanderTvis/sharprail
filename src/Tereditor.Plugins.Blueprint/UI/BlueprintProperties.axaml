<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpRail.Plugins.Blueprint.UI.BlueprintProperties"
             FontSize="12">
  <Expander Header="Properties" IsExpanded="True" HorizontalAlignment="Stretch" Padding="0,2,0,0">
    <ContentControl x:Name="Rows" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
  </Expander>
</UserControl>
