<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tereditor.Plugins.Blueprint.UI.BlueprintPane">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Border x:Name="Header" Padding="16,8" BorderThickness="0,0,0,1">
      <WrapPanel>
        <TextBlock x:Name="Brief" Margin="0,0,8,4" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="Raw" Content="Open raw source" Margin="0,0,8,4" />
        <Button x:Name="OutlineToggle" Content="Outline" Margin="0,0,8,4" />
        <TextBlock x:Name="Phase" Margin="0,0,0,4" VerticalAlignment="Center" TextWrapping="Wrap" Text="Waiting for the agent…" />
      </WrapPanel>
    </Border>
    <Border x:Name="Edits" Grid.Row="1" Padding="16,8" IsVisible="False">
      <WrapPanel>
        <TextBlock x:Name="EditCount" Margin="0,0,8,4" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="Confirm" Content="Confirm edits" Margin="0,0,8,4" />
        <Button x:Name="Discard" Content="Revert" Margin="0,0,0,4" />
      </WrapPanel>
    </Border>
    <Border x:Name="Changes" Grid.Row="2" Padding="16,8" IsVisible="False">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock x:Name="ChangeCount" TextWrapping="Wrap" />
          <WrapPanel x:Name="ChangeList" />
        </StackPanel>
        <Button x:Name="Dismiss" Grid.Column="1" Content="×" VerticalAlignment="Top" ToolTip.Tip="Dismiss" />
      </Grid>
    </Border>
    <Grid x:Name="Body" Grid.Row="3" ColumnDefinitions="Auto,*">
      <ScrollViewer x:Name="Outline" IsVisible="False" Width="180">
        <StackPanel x:Name="HeadingList" Spacing="4" Margin="8" />
      </ScrollViewer>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Document" Margin="16,12" MaxWidth="760" />
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
